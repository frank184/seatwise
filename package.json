{
  "name": "seatwise",
  "private": true,
  "scripts": {
    "format": "RUBYOPT='-rbundler/setup -r./script/prettier-ruby-json-compat.rb' prettier --write \"**/*.rb\" \"**/*.haml\" \"**/*.js\"",
    "format:check": "RUBYOPT='-rbundler/setup -r./script/prettier-ruby-json-compat.rb' prettier --check \"**/*.rb\" \"**/*.haml\" \"**/*.js\""
  },
  "devDependencies": {
    "@4az/prettier-plugin-html-erb": "^0.0.7",
    "@prettier/plugin-haml": "^0.1.0",
    "@prettier/plugin-ruby": "^4.0.4",
    "prettier": "^3.6.2"
  }
}
