!!!
%html{"data-controller": "portal--theme", "data-theme": "light", lang: "en"}
  %head
    %meta{content: "text/html; charset=UTF-8", "http-equiv": "Content-Type"}/
    %title= content_for(:title) || "Seatwise"
    %meta{content: "width=device-width,initial-scale=1", name: "viewport"}/
    %meta{content: "yes", name: "apple-mobile-web-app-capable"}/
    %meta{content: "Seatwise", name: "application-name"}/
    %meta{content: "yes", name: "mobile-web-app-capable"}/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    = javascript_tag nonce: true do
      try { if (localStorage.getItem("seatwise-theme") === "dark") document.documentElement.dataset.theme = "dark"; } catch (_) {}
    %script{src: "https://js.stripe.com/dahlia/stripe.js", async: true}
    %link{href: "/icon.svg", rel: "icon", type: "image/svg+xml"}/
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    = javascript_importmap_tags
  %body.flex.min-h-screen.flex-col.bg-base-200.text-base-content
    %header.navbar.sticky.top-0.z-20.min-h-12.border-b.border-base-300.px-3.backdrop-blur.sm:px-7{
      class: "bg-base-100/95"
    }
      .navbar-start
        = link_to root_path, class: "flex items-center gap-0 text-base-content no-underline" do
          %span{
            class: "relative grid size-9 shrink-0 place-items-center overflow-hidden rounded-full bg-base-200"
          }
            = image_tag "/logo.png", alt: "", class: "absolute left-1/2 top-1/2 size-11 max-w-none -translate-x-1/2 -translate-y-1/2 object-contain", aria: { hidden: "true" }
          %span{class: "flex flex-col items-start"}
            = image_tag "/text-light.png", alt: "Seatwise", class: "block h-7 w-auto object-contain object-left", data: { "portal--theme-target": "wordmark", light_src: "/text-light.png", dark_src: "/text-dark.png" }
            %span{class: "-mt-2 ml-1.5 text-xs leading-none text-base-content/55"} Find your place
      .navbar-end.gap-1.sm:gap-2
        %label.swap.swap-rotate.btn.btn-ghost.btn-circle{
          title: "Toggle dark mode",
          aria: { label: "Toggle dark mode" }
        }
          %input.theme-controller{
            type: "checkbox",
            value: "dark",
            data: { "portal--theme-target": "control", action: "change->portal--theme#change" }
          }/

          = lucide "moon", class: "swap-on size-5", aria: { hidden: "true" }
          = lucide "sun", class: "swap-off size-5", aria: { hidden: "true" }
        = link_to root_path, class: "btn btn-primary btn-sm gap-2" do
          Browse events
          = lucide "arrow-right", class: "size-4"
        %details.dropdown.dropdown-end
          %summary.btn.btn-ghost.btn-circle{aria: { label: "Reservation options" }}
            = lucide "user-round", class: "size-5"
          .dropdown-content.z-30.mt-3.w-72.rounded-box.border.border-base-300.bg-base-100.p-4.shadow-lg
            %p.text-sm.font-semibold Manage a reservation
            %p.mt-1.text-xs.leading-5{class: "text-base-content/60"}
              Use the one-time code emailed after payment to manage your booking.
            = button_tag type: :button, class: "btn btn-sm mt-3 w-full" do
              = lucide "key-round", class: "size-4"
              Enter email code
    .flex-1
      = yield
    %footer.footer.footer-horizontal.flex-col.justify-between.gap-3.border-t.border-base-300.bg-base-100.px-3.py-4.text-sm.sm:flex-row.sm:items-center.sm:px-7{
      class: "text-base-content/60"
    }
      %p Seatwise · Find your place in the room
      .flex.items-center.gap-5
        = link_to "System status", status_path, class: "link link-hover"
