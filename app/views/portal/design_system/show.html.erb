<main class="mx-auto max-w-6xl space-y-10 px-6 py-10 lg:px-10">
  <header class="navbar rounded-box bg-base-100 shadow-sm">
    <div class="flex-1 gap-3">
      <span class="grid size-10 place-items-center rounded-xl bg-primary text-primary-content font-bold">S</span>
      <div>
        <p class="font-bold tracking-tight">Seatwise</p>
        <p class="text-xs text-base-content/60">UI reference palette</p>
      </div>
    </div>
    <div class="flex-none">
      <span class="badge badge-outline">Rails UI</span>
    </div>
  </header>

  <section class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
    <div class="space-y-5">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Design starter</p>
      <h1 class="max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">A small palette for the Seatwise portal.</h1>
      <p class="max-w-xl text-base leading-7 text-base-content/70">
        Rails-rendered HTML, Tailwind utilities, and DaisyUI components. This page is a visual reference while the API and product flows take shape.
      </p>
      <div class="flex flex-wrap gap-3">
        <button class="btn btn-primary">Primary action</button>
        <button class="btn btn-outline">Secondary action</button>
        <button class="btn btn-ghost">Quiet action</button>
      </div>
    </div>

    <aside class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">Status examples</h2>
        <p class="text-sm text-base-content/60">Use text alongside color to keep status clear.</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="badge badge-success">Available</span>
          <span class="badge badge-warning">On hold</span>
          <span class="badge badge-error">Unavailable</span>
          <span class="badge badge-info">Confirmed</span>
        </div>
        <div class="divider"></div>
        <div class="flex items-center justify-between rounded-box bg-base-200 p-4">
          <div>
            <p class="font-semibold">Evening performance</p>
            <p class="text-sm text-base-content/60">Friday · 7:30 PM</p>
          </div>
          <button class="btn btn-sm btn-primary">View</button>
        </div>
      </div>
    </aside>
  </section>

  <section class="space-y-4">
    <div>
      <h2 class="text-xl font-bold">Theme tokens</h2>
      <p class="text-sm text-base-content/60">DaisyUI semantic colors adapt when the theme changes.</p>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
      <% [["primary", "bg-primary"], ["secondary", "bg-secondary"], ["accent", "bg-accent"], ["neutral", "bg-neutral"], ["info", "bg-info"], ["success", "bg-success"], ["warning", "bg-warning"], ["error", "bg-error"]].each do |token, color_class| %>
        <div class="rounded-box bg-base-100 p-3 shadow-sm">
          <div class="mb-3 h-12 rounded-lg <%= color_class %>"></div>
          <code class="text-xs"><%= token %></code>
        </div>
      <% end %>
    </div>
  </section>

  <section class="grid gap-6 md:grid-cols-2">
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">Form controls</h2>
        <label class="form-control w-full">
          <span class="label-text mb-2">Email address</span>
          <input type="email" class="input input-bordered w-full" placeholder="you@example.com" aria-label="Email address">
        </label>
        <label class="label cursor-pointer justify-start gap-3">
          <input type="checkbox" class="checkbox checkbox-primary">
          <span class="label-text">Send me booking updates</span>
        </label>
      </div>
    </div>

    <div class="card bg-primary text-primary-content shadow-sm">
      <div class="card-body justify-between sm:flex-row sm:items-center">
        <div>
          <h2 class="card-title">Color and contrast</h2>
          <p class="mt-1 text-sm opacity-80">A sample callout using semantic theme colors.</p>
        </div>
        <button class="btn btn-ghost border-current">Explore</button>
      </div>
    </div>
  </section>

  <footer class="border-t border-base-300 pt-5 text-sm text-base-content/50">
    Seatwise · UI reference only · <%= link_to "API health", "/api/v1/up", class: "link link-hover" %>
  </footer>
</main>
