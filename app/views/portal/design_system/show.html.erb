<div class="min-h-screen bg-base-200/70">
  <header class="navbar border-b border-base-300 bg-base-100 px-4 sm:px-8">
    <div class="navbar-start gap-3">
      <%= link_to root_path, class: "flex items-center gap-3 text-base-content no-underline" do %>
        <span
          class="grid size-10 place-items-center rounded-2xl bg-primary text-lg font-black text-primary-content"
          >s</span
        >
        <span>
          <span class="block text-base font-bold tracking-tight">seatwise</span>
          <span class="block text-xs text-base-content/55">Design system</span>
        </span>
      <% end %>
    </div>
    <div class="navbar-center hidden md:flex">
      <nav
        aria-label="Showcase sections"
        class="flex items-center gap-6 text-sm font-medium text-base-content/65"
      >
        <a href="#foundations" class="link link-hover">Foundations</a>
        <a href="#components" class="link link-hover">Components</a>
        <a href="#patterns" class="link link-hover">Product patterns</a>
        <a href="#booking-flow" class="link link-hover">Booking flow</a>
        <a href="#model-examples" class="link link-hover">Model examples</a>
      </nav>
    </div>
    <div class="navbar-end gap-3">
      <%= badge "UI reference", style: :outline, extra_class: "hidden sm:inline-flex" %>
      <%= link_to "Browse events", events_path, class: "btn btn-sm" %>
    </div>
  </header>

  <main class="mx-auto max-w-7xl space-y-12 px-4 py-8 sm:px-8 sm:py-12">
    <section
      class="relative isolate overflow-hidden rounded-box bg-neutral text-neutral-content shadow-xl"
    >
      <div
        class="absolute -right-16 -top-24 -z-10 size-96 rounded-full bg-primary/20 blur-3xl"
        aria-hidden="true"
      ></div>
      <div
        class="grid gap-10 px-6 py-10 sm:px-10 sm:py-14 lg:grid-cols-[1fr_auto] lg:items-end lg:px-14"
      >
        <div class="max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-primary">
            Seatwise · UI foundations
          </p>
          <h1 class="text-4xl font-black tracking-tight sm:text-6xl">
            A thoughtful system<br class="hidden sm:block" />
            for finding your place.
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-7 text-neutral-content/70 sm:text-lg">
            A practical reference for the Seatwise portal: calm surfaces, clear status, accessible
            controls, and booking patterns built with Rails, Tailwind, and daisyUI.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <%= button "Explore components", variant: :primary, href: "#components" %>
          <%= button "View foundations",
                     variant: :ghost,
                     href: "#foundations",
                     class: "border border-neutral-content/25 text-neutral-content" %>
        </div>
      </div>
      <div class="grid border-t border-neutral-content/10 sm:grid-cols-3">
        <div class="px-6 py-4 sm:px-10">
          <p class="text-xs uppercase tracking-widest text-neutral-content/50">Principle</p>
          <p class="mt-1 font-semibold">Clarity before decoration</p>
        </div>
        <div
          class="border-t border-neutral-content/10 px-6 py-4 sm:border-l sm:border-t-0 sm:px-10"
        >
          <p class="text-xs uppercase tracking-widest text-neutral-content/50">Color</p>
          <p class="mt-1 font-semibold">Semantic and adaptable</p>
        </div>
        <div
          class="border-t border-neutral-content/10 px-6 py-4 sm:border-l sm:border-t-0 sm:px-10"
        >
          <p class="text-xs uppercase tracking-widest text-neutral-content/50">Components</p>
          <p class="mt-1 font-semibold">Composable by default</p>
        </div>
      </div>
    </section>

    <section id="foundations" class="space-y-5 scroll-mt-8" aria-labelledby="foundations-heading">
      <%= section_heading kicker: "01 · Foundations",
                          title: "A flexible visual language",
                          description:
                            "Use theme tokens for color so every component stays legible when the active theme changes.",
                          heading_id: "foundations-heading" %>

      <div class="grid gap-5 lg:grid-cols-[1.35fr_0.65fr]">
        <%= card body_class: "gap-5" do %>
          <div class="flex items-center justify-between gap-3">
            <div>
              <%= card_title "Semantic palette" %>
              <p class="text-sm text-base-content/60">
                Status and brand colors with matching foregrounds.
              </p>
            </div>
            <%= badge "Theme-aware", style: :ghost %>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <% [
                 %w[Primary bg-primary text-primary-content],
                 %w[Secondary bg-secondary text-secondary-content],
                 %w[Accent bg-accent text-accent-content],
                 %w[Neutral bg-neutral text-neutral-content],
                 %w[Info bg-info text-info-content],
                 %w[Success bg-success text-success-content],
                 %w[Warning bg-warning text-warning-content],
                 %w[Error bg-error text-error-content]
               ].each do |name, color_class, text_class| %>
              <div class="overflow-hidden rounded-box border border-base-300 bg-base-100">
                <div class="flex h-16 items-end p-3 <%= color_class %> <%= text_class %>">
                  <span class="text-xs font-semibold"><%= name %></span>
                </div>
                <div class="px-3 py-2">
                  <code class="text-xs text-base-content/60"><%= color_class %></code>
                </div>
              </div>
            <% end %>
          </div>
          <div class="grid gap-3 sm:grid-cols-3">
            <% [
                 %w[Canvas bg-base-100 text-base-content],
                 ["Subtle surface", "bg-base-200", "text-base-content"],
                 ["Raised edge", "bg-base-300", "text-base-content"]
               ].each do |name, color_class, text_class| %>
              <div
                class="flex items-center justify-between rounded-box border border-base-300 p-3 <%= color_class %> <%= text_class %>"
              >
                <span class="text-sm font-medium"><%= name %></span
                ><code class="text-xs opacity-60"><%= color_class %></code>
              </div>
            <% end %>
          </div>
        <% end %>

        <%= card title: "Type scale", description: "A compact hierarchy keeps event details easy to scan." do %>
          <div class="mt-2 space-y-4">
            <div>
              <p class="text-3xl font-black tracking-tight">Display</p>
              <code class="text-xs text-base-content/50">text-3xl / font-black</code>
            </div>
            <div>
              <p class="text-xl font-bold tracking-tight">Section heading</p>
              <code class="text-xs text-base-content/50">text-xl / font-bold</code>
            </div>
            <div>
              <p class="text-base font-medium">Body copy for readable details.</p>
              <code class="text-xs text-base-content/50">text-base / font-medium</code>
            </div>
            <div>
              <p class="text-sm text-base-content/60">Supporting information and metadata</p>
              <code class="text-xs text-base-content/50">text-sm / muted</code>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <section id="components" class="space-y-5 scroll-mt-8" aria-labelledby="components-heading">
      <%= section_heading kicker: "02 · Components",
                          title: "Useful building blocks",
                          heading_id: "components-heading" %>
      <div class="grid gap-5 lg:grid-cols-2">
        <%= card title: "Actions",
                 description: "Reserve emphasis for the next meaningful step.",
                 body_class: "gap-5" do %>
          <div class="flex flex-wrap items-center gap-2">
            <%= button "Primary action", variant: :primary %><%= button "Default action" %><%= button "Outline", variant: :outline %><%= button "Quiet action", variant: :ghost %>
          </div>
          <div class="flex flex-wrap items-center gap-2 border-t border-base-200 pt-4">
            <%= button "Compact", variant: :primary, size: :sm %><%= button variant: :outline, class: "btn-square", aria: { label: "Add to favorites" } do %><%= lucide "heart", class: "size-4" %><% end %><%= button "Unavailable", disabled: true, class: "btn-disabled", aria: { disabled: true }, tabindex: -1 %>
          </div>
        <% end %>

        <%= card title: "Status",
                 description: "Pair color with direct labels for quick recognition.",
                 body_class: "gap-5" do %>
          <div class="flex flex-wrap gap-2">
            <%= status_badge "Available", variant: :success %><%= status_badge "On hold", variant: :warning %><%= status_badge "Unavailable", variant: :error %><%= status_badge "Confirmed", variant: :info %><%= badge "General admission", style: :outline %>
          </div>
          <%= status_alert title: "Your seats are held",
                           description: "Complete checkout within 5 minutes to confirm the reservation.",
                           icon: "info" %>
        <% end %>

        <%= card title: "Form controls",
                 description: "Keep labels visible and group related choices.",
                 body_class: "gap-5" do %>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="form-control w-full"
              ><span class="label-text mb-2 font-medium">Search events</span
              ><input
                type="search"
                class="input input-bordered w-full"
                placeholder="Artist, venue, or event"
                aria-label="Search events"
            /></label>
            <label class="form-control w-full"
              ><span class="label-text mb-2 font-medium">Date range</span
              ><select class="select select-bordered w-full" aria-label="Date range">
                <option>Any upcoming date</option>
                <option>This week</option>
                <option>This month</option>
              </select></label
            >
          </div>
          <label class="label cursor-pointer justify-start gap-3"
            ><input type="checkbox" class="checkbox checkbox-primary" /><span class="label-text"
              >Email me when more seats open</span
            ></label
          >
        <% end %>

        <%= card title: "Surface and selection",
                 description: "Use subtle elevation to distinguish interactive groups.",
                 body_class: "gap-5" do %>
          <div class="rounded-box border border-base-300 bg-base-200 p-4">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="font-semibold">Mezzanine · Row B</p>
                <p class="mt-1 text-sm text-base-content/60">12 seats available</p>
              </div>
              <%= badge "Open", variant: :success, style: :soft %>
            </div>
            <div class="mt-4 flex flex-wrap gap-2">
              <%= button "Row A", size: :sm %><%= button "Row B", size: :sm, variant: :primary, aria: { pressed: true } %><%= button "Row C", size: :sm %>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <section id="patterns" class="space-y-5 scroll-mt-8" aria-labelledby="patterns-heading">
      <%= section_heading kicker: "03 · Product patterns",
                          title: "The event card, in context",
                          description:
                            "Show the details guests need to decide: when, where, and how much availability remains.",
                          heading_id: "patterns-heading" %>
      <div class="grid gap-5 lg:grid-cols-[1.4fr_0.6fr]">
        <%= card element: :article,
                 body: false,
                 card_class: "card-border overflow-hidden bg-base-100 shadow-sm sm:card-side" do %>
          <div
            class="relative grid min-h-56 place-items-center overflow-hidden bg-gradient-to-br from-primary/25 via-secondary/15 to-accent/25 sm:w-2/5"
          >
            <div
              class="absolute -left-10 -top-10 size-48 rounded-full bg-primary/20 blur-2xl"
              aria-hidden="true"
            ></div>
            <div
              class="relative grid size-32 place-items-center rounded-full border border-base-content/10 bg-base-100/70 text-5xl font-black tracking-tighter text-base-content/70"
            >
              M
            </div>
            <%= badge "Illustrative · Nov 20", variant: :neutral, extra_class: "absolute left-4 top-4" %>
            <%= badge "18 seats open", variant: :success, extra_class: "absolute bottom-4 left-4" %>
          </div>
          <%= card_body body_class: "justify-between gap-5 sm:p-7" do %>
            <div>
              <p class="text-sm font-medium text-base-content/55">7:30 PM · The Grand Room</p>
              <%= card_title "Midnight in the Garden", extra_class: "mt-2 text-2xl" %>
              <p class="mt-2 max-w-lg text-sm leading-6 text-base-content/65">
                An intimate live performance in a beautifully restored downtown venue.
              </p>
            </div>
            <div
              class="flex flex-wrap items-center justify-between gap-3 border-t border-base-200 pt-4"
            >
              <span class="text-sm text-base-content/60">72 seats in this room</span
              ><%= button variant: :primary, href: events_path do %>
                Explore event <%= lucide "arrow-right", class: "size-4" %>
              <% end %>
            </div>
          <% end %>
        <% end %>
        <%= card element: :aside,
                 card_class: "bg-primary text-primary-content shadow-sm",
                 body_class: "justify-between" do %>
          <div>
            <%= badge "Interaction principle",
                      extra_class: "border-primary-content/20 bg-primary-content/10 text-primary-content" %>
            <h3 class="mt-5 text-2xl font-bold tracking-tight">Make the next step obvious.</h3>
            <p class="mt-3 text-sm leading-6 opacity-80">
              One clear primary action per decision point. Keep supporting actions visible, calm,
              and easy to understand.
            </p>
          </div>
          <%= button variant: :ghost,
                     href: "#components",
                     class: "mt-6 justify-between border border-primary-content/25 text-primary-content" do %>
            Back to components <%= lucide "arrow-up", class: "size-4" %>
          <% end %>
        <% end %>
      </div>
    </section>

    <section id="booking-flow" class="space-y-5 scroll-mt-8" aria-labelledby="booking-flow-heading">
      <%= section_heading kicker: "04 · Reservation flow",
                          title: "One step at a time, with context",
                          description:
                            "Keep the current step clear, preserve the booking summary, and explain what happens after each submission.",
                          heading_id: "booking-flow-heading" %>

      <%= card body_class: "gap-7 p-5 sm:p-8" do %>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <%= badge "Step 2 of 5", variant: :primary, style: :soft %>
            <h3 class="mt-3 text-xl font-bold">Your contact details</h3>
            <p class="mt-1 text-sm text-base-content/60">
              We’ll use this email for your hold and booking updates.
            </p>
          </div>
          <%= badge "Hold active · 04:32 left", variant: :warning, style: :soft %>
        </div>

        <%= step_indicator label: "Booking progress",
                           steps: ["Choose seats", "Your details", "Review", "Payment", "Confirmation"],
                           current_step: 2 %>

        <div class="grid gap-8 lg:grid-cols-[1fr_0.72fr]">
          <form class="space-y-5" aria-label="Example reservation contact form">
            <fieldset class="fieldset rounded-box border border-base-300 p-4 sm:p-5">
              <legend class="fieldset-legend px-1 text-base">Contact information</legend>
              <%= field label: "Email address",
                        name: "reservation[email]",
                        type: "email",
                        value: "alex@",
                        required: true,
                        hint: "Your booking confirmation will be sent here.",
                        error: "Enter a complete email address." %>
              <%= field label: "Name (optional)",
                        name: "reservation[name]",
                        type: "text",
                        placeholder: "Name on the booking",
                        input_class: "mt-3" %>
              <%= field label: "Phone (optional)",
                        name: "reservation[phone]",
                        type: "tel",
                        value: "+1 416 555 0142",
                        hint: "Used only for urgent event updates.",
                        input_class: "input-success mt-3" %>
              <label class="label mt-2 cursor-pointer justify-start gap-3">
                <input type="checkbox" class="checkbox checkbox-primary" checked />
                <span class="label-text">Send me event updates and booking changes</span>
              </label>
            </fieldset>
            <div class="flex flex-wrap justify-between gap-3">
              <%= button variant: :ghost do %>
                <%= lucide "arrow-left", class: "size-4" %>
                Back to seats
              <% end %><%= button variant: :primary do %>
                Continue to review <%= lucide "arrow-right", class: "size-4" %>
              <% end %>
            </div>
          </form>

          <aside class="space-y-4">
            <%= reservation_summary event_name: "Midnight in the Garden",
                                    event_date: "Fri, Nov 20 · 7:30 PM",
                                    row_id: "front_a",
                                    row_label: "A",
                                    seat_start: 8,
                                    seat_end: 10,
                                    status_label: "Held",
                                    status_variant: :warning,
                                    hold_deadline: "7:42 PM",
                                    total: "$84.00",
                                    editable: true %>
            <%= status_alert title: "Seats are held temporarily",
                             description: "Checkout does not extend the hold deadline.",
                             variant: :warning,
                             icon: "clock-3" %>
          </aside>
        </div>
      <% end %>

      <div class="grid gap-5 lg:grid-cols-[1fr_0.8fr]">
        <%= card title: "Reservation lifecycle",
                 description: "A timeline distinguishes user progress from reservation state.",
                 body_class: "gap-5" do %>
          <div class="grid gap-5 md:grid-cols-[0.75fr_1.25fr] md:items-start">
            <aside class="rounded-box border border-base-300 bg-base-200 p-4">
              <p class="text-xs font-bold uppercase tracking-wider text-base-content/50">
                Active reservation
              </p>
              <p class="mt-2 font-semibold">Midnight in the Garden</p>
              <p class="mt-1 text-sm text-base-content/60">Fri, Nov 20 · 7:30 PM</p>
              <div class="my-4 border-t border-base-300"></div>
              <div class="flex items-center justify-between gap-3">
                <span class="text-sm text-base-content/60">Seats held</span
                ><%= badge "04:32 left", variant: :warning, style: :soft %>
              </div>
              <p class="mt-2 text-sm font-medium">Row A · 8–10</p>
              <p class="font-mono text-xs text-base-content/55">row_id: front_a</p>
              <div class="mt-4 flex justify-between border-t border-base-300 pt-3 text-sm">
                <span class="text-base-content/60">Estimated total</span
                ><span class="font-semibold">$84.00</span>
              </div>
            </aside>
            <ul
              class="timeline timeline-vertical timeline-compact timeline-snap-icon mx-0 w-full max-w-none"
            >
              <li>
                <div class="timeline-middle text-success">
                  <%= lucide "circle-check", class: "size-5", decorative: false, aria: { label: "Complete" } %>
                </div>
                <div class="timeline-end timeline-box w-full">
                  <time class="text-xs text-base-content/50">7:37 PM</time>
                  <p class="font-semibold">Choose seats</p>
                  <p class="text-sm text-base-content/60">Row A · seats 8–10 · reservation held.</p>
                </div>
                <hr class="bg-success" />
              </li>
              <li>
                <hr class="bg-success" />
                <div class="timeline-middle text-primary">
                  <%= lucide "circle-dot", class: "size-5", decorative: false, aria: { label: "Current step" } %>
                </div>
                <div class="timeline-end timeline-box w-full border-primary">
                  <time class="text-xs text-base-content/50">Now</time>
                  <p class="font-semibold">Your details</p>
                  <p class="text-sm text-base-content/60">
                    Add an email so we can send the booking update.
                  </p>
                </div>
                <hr />
              </li>
              <li>
                <hr />
                <div class="timeline-middle text-base-content/40">
                  <%= lucide "circle", class: "size-5", decorative: false, aria: { label: "Upcoming" } %>
                </div>
                <div class="timeline-end timeline-box w-full">
                  <p class="font-semibold">Review</p>
                  <p class="text-sm text-base-content/60">
                    Check the reservation and total before payment.
                  </p>
                </div>
                <hr />
              </li>
              <li>
                <hr />
                <div class="timeline-middle text-base-content/40">
                  <%= lucide "circle", class: "size-5", decorative: false, aria: { label: "Upcoming" } %>
                </div>
                <div class="timeline-end timeline-box w-full">
                  <p class="font-semibold">Payment</p>
                  <p class="text-sm text-base-content/60">
                    Complete checkout before the 7:42 PM hold deadline.
                  </p>
                </div>
                <hr />
              </li>
              <li>
                <hr />
                <div class="timeline-middle text-base-content/40">
                  <%= lucide "circle", class: "size-5", decorative: false, aria: { label: "Upcoming" } %>
                </div>
                <div class="timeline-end timeline-box w-full">
                  <p class="font-semibold">Confirmation</p>
                  <p class="text-sm text-base-content/60">
                    Your booking reference and seats appear after payment succeeds.
                  </p>
                </div>
              </li>
            </ul>
          </div>
        <% end %>
        <%= card title: "Submission states",
                 description: "Separate examples show one response at a time.",
                 body_class: "gap-5" do %>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-box border border-error/30 p-4">
              <%= badge "Availability conflict", variant: :error, style: :soft, extra_class: "mb-3" %><%= status_alert title: "Seats just became unavailable",
                               description: "Refresh availability, then choose another block.",
                               variant: :error,
                               icon: "triangle-alert",
                               soft: true,
                               action: button("Refresh", variant: :error, size: :sm) %>
            </div>
            <div class="rounded-box border border-error/30 p-4">
              <%= badge "Payment retry", variant: :error, style: :soft, extra_class: "mb-3" %><%= status_alert title: "Payment didn’t complete",
                               description: "Your hold is still active. Retry before the deadline.",
                               variant: :error,
                               icon: "triangle-alert",
                               soft: true,
                               action: button("Retry", variant: :error, size: :sm) %>
            </div>
            <div class="rounded-box border border-warning/30 p-4">
              <%= badge "Hold expiry", variant: :warning, style: :soft, extra_class: "mb-3" %><%= status_alert title: "Hold expired",
                               description: "No payment was taken. Start again to select new seats.",
                               variant: :warning,
                               icon: "clock-3",
                               soft: true %>
            </div>
            <div class="rounded-box border border-base-300 p-4">
              <%= badge "In progress", style: :ghost, extra_class: "mb-3" %>
              <div class="flex items-center gap-3 rounded-box bg-base-200 p-4">
                <span
                  class="loading loading-spinner loading-sm text-primary"
                  aria-hidden="true"
                ></span>
                <div>
                  <p class="font-semibold">Starting secure checkout</p>
                  <p class="text-sm text-base-content/60">Preparing the payment session.</p>
                </div>
              </div>
            </div>
            <div class="rounded-box border border-success/30 p-4 sm:col-span-2">
              <%= badge "Success", variant: :success, style: :soft, extra_class: "mb-3" %><%= status_alert title: "Reservation confirmed",
                               description: "Your booking reference and seats are ready.",
                               variant: :success,
                               icon: "circle-check",
                               soft: true %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="grid gap-5 lg:grid-cols-2">
        <%= card element: :article, body_class: "gap-5" do %>
          <div class="flex items-start justify-between gap-3">
            <div>
              <%= badge "Step 3 · Review", variant: :primary, style: :soft %><%= card_title "Check your reservation", extra_class: "mt-3" %>
              <p class="text-sm text-base-content/60">
                Give guests a final chance to verify the held seats and price.
              </p>
            </div>
            <%= lucide "clipboard-check", class: "size-6 text-primary" %>
          </div>
          <dl class="divide-y divide-base-200 rounded-box border border-base-300 px-4 text-sm">
            <div class="flex justify-between gap-4 py-3">
              <dt class="text-base-content/60">Event</dt>
              <dd class="text-right font-medium">
                Midnight in the Garden<br /><span class="font-normal text-base-content/55"
                  >Fri, Nov 20 · 7:30 PM</span
                >
              </dd>
            </div>
            <div class="flex justify-between gap-4 py-3">
              <dt class="text-base-content/60">Seats</dt>
              <dd class="text-right font-medium">
                Row A · 8–10<br /><span class="font-mono text-xs text-base-content/55"
                  >row_id: front_a</span
                >
              </dd>
            </div>
            <div class="flex justify-between gap-4 py-3">
              <dt class="text-base-content/60">Total</dt>
              <dd class="font-semibold">$84.00</dd>
            </div>
          </dl>
          <label class="label cursor-pointer justify-start gap-3"
            ><input type="checkbox" class="checkbox checkbox-primary" /><span class="label-text"
              >I’ve checked the event and seat details</span
            ></label
          >
          <div class="flex flex-wrap justify-between gap-3 border-t border-base-200 pt-4">
            <%= button "Edit details", variant: :ghost %><%= button variant: :primary do %>
              Continue to payment <%= lucide "arrow-right", class: "size-4" %>
            <% end %>
          </div>
        <% end %>

        <%= card element: :article, body_class: "gap-5" do %>
          <div class="flex items-start justify-between gap-3">
            <div>
              <%= badge "Step 4 · Payment", variant: :primary, style: :soft %><%= card_title "Secure checkout", extra_class: "mt-3" %>
              <p class="text-sm text-base-content/60">
                Show the amount and hold deadline beside payment fields.
              </p>
            </div>
            <%= lucide "shield-check", class: "size-6 text-primary" %>
          </div>
          <%= status_alert title: "$84.00 due · seats held until 7:42 PM",
                           description: "",
                           variant: :info,
                           icon: "clock-3",
                           soft: true,
                           role: "status" %>
          <form class="space-y-4" aria-label="Example payment form">
            <%= field label: "Name on card",
                      name: "payment[name]",
                      type: "text",
                      value: "Alex Rivera",
                      required: true %>
            <%= field label: "Card number",
                      name: "payment[number]",
                      type: "text",
                      value: "••••  ••••  ••••  4242",
                      required: true,
                      hint: "Demo value only · card details are handled by the payment provider." %>
            <div class="grid grid-cols-2 gap-3">
              <%= field label: "Expiry", name: "payment[expiry]", type: "text", placeholder: "MM / YY", required: true %><%= field label: "Security code",
                        name: "payment[cvc]",
                        type: "password",
                        placeholder: "CVC",
                        required: true %>
            </div>
            <div class="flex flex-wrap justify-between gap-3 border-t border-base-200 pt-4">
              <%= button "Back to review", variant: :ghost %><%= button variant: :primary do %>
                <%= lucide "lock-keyhole", class: "size-4" %>
                Pay $84.00
              <% end %>
            </div>
          </form>
        <% end %>
      </div>
    </section>

    <section
      id="model-examples"
      class="space-y-5 scroll-mt-8"
      aria-labelledby="model-examples-heading"
    >
      <%= section_heading kicker: "05 · Model examples",
                          title: "Small views around the domain",
                          description:
                            "These are design patterns for focused tasks and records, not complete admin platforms.",
                          heading_id: "model-examples-heading" %>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        <%= card element: :article, body_class: "gap-4" do %>
          <%= record_heading title: "Venue · layout rows", kind: "Venue" %>
          <p class="text-sm text-base-content/60">
            Edit the reusable layout; event inventory gets its own published snapshot.
          </p>
          <%= data_table headers: %w[row_id Label Order Seats],
                         rows: [
                           [tag.span("front_1", class: "font-mono"), "A", "1", "12"],
                           [tag.span("middle_1", class: "font-mono"), "B", "2", "16"]
                         ] %><%= button "Add a row", size: :sm, variant: :outline, class: "self-start" %>
        <% end %>

        <%= card element: :article, body_class: "gap-4" do %>
          <%= record_heading title: "Event · publish", kind: "Event" %>
          <p class="text-sm text-base-content/60">
            Choose a venue and schedule, then review the inventory snapshot.
          </p>
          <form class="space-y-3" aria-label="Example event form">
            <%= field label: "Event name",
                      name: "event[name]",
                      type: "text",
                      value: "Midnight in the Garden",
                      input_class: "input-sm" %>
            <div class="grid grid-cols-2 gap-3">
              <%= field label: "Starts",
                        name: "event[starts_at]",
                        type: "datetime-local",
                        value: "2026-11-20T19:30",
                        input_class: "input-sm" %><label class="form-control"
                ><span class="label-text mb-1 font-medium">Venue</span
                ><select class="select select-bordered select-sm w-full">
                  <option>The Grand Room</option>
                </select></label
              >
            </div>
            <div class="rounded-box bg-base-200 p-3 text-sm">
              <span class="font-semibold">Snapshot preview</span
              ><span class="ml-2 text-base-content/60">3 rows · 72 seats</span>
            </div>
            <%= button "Review event", type: "button", size: :sm, variant: :primary %>
          </form>
        <% end %>

        <%= card element: :article, body_class: "gap-4" do %>
          <%= record_heading title: "Customer · profile", kind: "Customer" %>
          <p class="text-sm text-base-content/60">
            A customer can hold reservations before verifying their email.
          </p>
          <div class="rounded-box border border-base-300 p-4">
            <div class="flex items-center gap-3">
              <div class="avatar placeholder shrink-0">
                <div
                  class="flex size-11 items-center justify-center rounded-full bg-secondary text-secondary-content"
                >
                  <span class="text-sm font-semibold leading-none">AR</span>
                </div>
              </div>
              <div class="min-w-0">
                <p class="font-semibold">Alex Rivera</p>
                <p class="text-sm text-base-content/60">alex@example.com</p>
              </div>
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-2">
              <%= badge "Email unverified", variant: :warning, style: :soft %><%= badge "2 reservations", style: :ghost %>
            </div>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-base-content/60">Recent payment</span
            ><span class="font-medium">via reservation</span>
          </div>
          <%= button "View reservations", size: :sm, class: "self-start" %>
        <% end %>

        <%= card element: :article, body_class: "gap-4" do %>
          <%= record_heading title: "Reservation · detail", kind: "Reservation" %>
          <p class="text-sm text-base-content/60">
            Show API vocabulary and explain which actions remain available.
          </p>
          <dl class="space-y-3 rounded-box border border-base-300 p-4 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-base-content/60">Reference</dt>
              <dd class="font-mono font-semibold">res_42</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-base-content/60">row_id</dt>
              <dd class="font-mono">front_a</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-base-content/60">seat_start – seat_end</dt>
              <dd class="font-semibold">5 – 6</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-base-content/60">Status</dt>
              <dd><%= status_badge "Confirmed", variant: :success %></dd>
            </div>
          </dl>
          <div class="flex gap-2">
            <%= button "View event", size: :sm %><%= button "Get help", size: :sm, variant: :outline %>
          </div>
        <% end %>

        <%= card element: :article, body_class: "gap-4" do %>
          <%= record_heading title: "Payment · attempt", kind: "Payment" %>
          <p class="text-sm text-base-content/60">
            Payments belong to reservations; the customer is reached through that reservation.
          </p>
          <%= data_table headers: ["External ID", "Reservation", "Status"],
                         rows: [
                           [
                             tag.span("pay_42", class: "font-mono"),
                             tag.span("res_42", class: "font-mono"),
                             status_badge("Pending", variant: :info, small: true)
                           ],
                           [
                             tag.span("pay_41", class: "font-mono"),
                             tag.span("res_41", class: "font-mono"),
                             status_badge("Succeeded", variant: :success, small: true)
                           ],
                           [
                             tag.span("pay_40", class: "font-mono"),
                             tag.span("res_40", class: "font-mono"),
                             status_badge("Failed", variant: :error, small: true)
                           ]
                         ] %>
          <div class="flex gap-2">
            <%= button "Retry pending", size: :sm, variant: :primary %><%= button "View reservation", size: :sm, variant: :ghost %>
          </div>
        <% end %>

        <%= card element: :article, body_class: "gap-4", card_class: "md:col-span-2 xl:col-span-3" do %>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <%= card_title "Reservation list" %>
              <p class="mt-1 text-sm text-base-content/60">
                A wider operational view keeps reference, seats, event, and status together.
              </p>
            </div>
            <%= badge "Operations", style: :outline %>
          </div>
          <div class="flex flex-wrap gap-2">
            <input
              type="search"
              class="input input-bordered input-sm min-w-40 grow"
              placeholder="Search reference or email"
              aria-label="Search reservations"
            /><select
              class="select select-bordered select-sm"
              aria-label="Filter reservation status"
            >
              <option>All statuses</option>
              <option>Held</option>
              <option>Confirmed</option>
              <option>Expired</option>
            </select>
          </div>
          <%= data_table headers: [
                           "Reference",
                           "Event",
                           "Customer",
                           "Seats",
                           "Event time",
                           "Status",
                           tag.span("Actions", class: "sr-only")
                         ],
                         zebra: true,
                         rows: [
                           [
                             tag.span("res_1042", class: "font-mono"),
                             "Midnight in the Garden",
                             safe_join(
                               [
                                 "Alex Rivera",
                                 tag.span(
                                   "alex@example.com",
                                   class: "block text-xs font-normal text-base-content/55"
                                 )
                               ]
                             ),
                             safe_join(
                               [
                                 tag.span("Row A · 8–10", class: "font-semibold"),
                                 tag.span("front_a", class: "block font-mono text-xs text-base-content/55")
                               ]
                             ),
                             "Fri, Nov 20 · 7:30 PM",
                             status_badge("Held", variant: :warning, small: true),
                             button(variant: :ghost, size: :xs, aria: { label: "Open reservation res_1042" }) {
                               lucide "arrow-up-right", class: "size-4"
                             }
                           ],
                           [
                             tag.span("res_1041", class: "font-mono"),
                             "Blue Hour Quartet",
                             safe_join(
                               [
                                 "Sam Kim",
                                 tag.span(
                                   "sam@example.com",
                                   class: "block text-xs font-normal text-base-content/55"
                                 )
                               ]
                             ),
                             safe_join(
                               [
                                 tag.span("Row C · 8–10", class: "font-semibold"),
                                 tag.span("row_c", class: "block font-mono text-xs text-base-content/55")
                               ]
                             ),
                             "Sat, Nov 21 · 8:00 PM",
                             status_badge("Confirmed", variant: :success, small: true),
                             button(variant: :ghost, size: :xs, aria: { label: "Open reservation res_1041" }) {
                               lucide "arrow-up-right", class: "size-4"
                             }
                           ],
                           [
                             tag.span("res_1040", class: "font-mono"),
                             "Late Show Sessions",
                             safe_join(
                               [
                                 "Jules Morgan",
                                 tag.span(
                                   "jules@example.com",
                                   class: "block text-xs font-normal text-base-content/55"
                                 )
                               ]
                             ),
                             safe_join(
                               [
                                 tag.span("Row B · 1–2", class: "font-semibold"),
                                 tag.span("row_b", class: "block font-mono text-xs text-base-content/55")
                               ]
                             ),
                             "Sun, Nov 22 · 6:00 PM",
                             status_badge("Expired", variant: :ghost, small: true),
                             button(variant: :ghost, size: :xs, aria: { label: "Open reservation res_1040" }) {
                               lucide "arrow-up-right", class: "size-4"
                             }
                           ]
                         ] %>
          <div class="flex items-center justify-between text-xs text-base-content/55">
            <span>Showing 1–3 of 24 reservations</span>
            <div class="join">
              <%= button "«", size: :xs, class: "join-item", aria: { label: "Previous page" } %><%= button "1", size: :xs, class: "join-item btn-active", aria: { current: "page" } %><%= button "2", size: :xs, class: "join-item" %><%= button "»", size: :xs, class: "join-item", aria: { label: "Next page" } %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        <%= card card_class: "border border-base-300 bg-base-100", body_class: "p-5" do %>
          <%= badge "Loading", style: :ghost, extra_class: "self-start" %>
          <div class="skeleton mt-2 h-4 w-2/3"></div>
          <div class="skeleton h-4 w-full"></div>
          <div class="skeleton h-4 w-4/5"></div>
        <% end %>
        <%= card card_class: "border border-base-300 bg-base-100", body_class: "items-center p-5 text-center" do %>
          <%= badge "Empty", style: :ghost %>
          <h3 class="mt-1 font-semibold">No reservations yet</h3>
          <p class="text-sm text-base-content/60">New bookings will appear here.</p>
          <%= button "Browse events", size: :sm, href: events_path %>
        <% end %>
        <%= status_alert title: "Couldn’t load reservations",
                         description: "Your data is unchanged. Try again.",
                         variant: :error,
                         icon: "triangle-alert",
                         extra_class: "items-start",
                         action: button("Retry", variant: :error, size: :sm) %>
      </div>
    </section>

    <footer
      class="flex flex-col gap-3 border-t border-base-300 pt-6 text-sm text-base-content/55 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>Seatwise · Design system reference</p>
      <div class="flex items-center gap-4">
        <%= link_to "Browse events", events_path, class: "link link-hover" %><%= link_to "API health", "/api/v1/up", class: "link link-hover" %>
      </div>
    </footer>
  </main>
</div>
