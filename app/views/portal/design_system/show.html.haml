.min-h-screen{class: "bg-base-200/70"}
  %header.navbar.border-b.border-base-300.bg-base-100.px-4.sm:px-8
    .navbar-start.gap-3
      = link_to root_path, class: "flex items-center gap-3 text-base-content no-underline" do
        %span.grid.size-10.place-items-center.rounded-2xl.bg-primary.text-lg.font-black.text-primary-content
          s
        %span
          %span.block.text-base.font-bold.tracking-tight seatwise
          %span.block.text-xs{class: "text-base-content/55"} Design system
    .navbar-center.hidden.md:flex
      %nav.flex.items-center.gap-6.text-sm.font-medium{"aria-label" => "Showcase sections", class: "text-base-content/65"}
        %a.link.link-hover{href: "#foundations"} Foundations
        %a.link.link-hover{href: "#components"} Components
        %a.link.link-hover{href: "#patterns"} Product patterns
        %a.link.link-hover{href: "#booking-flow"} Booking flow
        %a.link.link-hover{href: "#model-examples"} Model examples
    .navbar-end.gap-3
      = badge "UI reference", style: :outline, extra_class: "hidden sm:inline-flex"
      = link_to "Browse events", events_path, class: "btn btn-sm"
  %main.mx-auto.max-w-7xl.space-y-12.px-4.py-8.sm:px-8.sm:py-12
    %section.relative.isolate.overflow-hidden.rounded-box.bg-neutral.text-neutral-content.shadow-xl
      .absolute.-right-16.-top-24.-z-10.size-96.rounded-full.blur-3xl{"aria-hidden" => "true", class: "bg-primary/20"}
      .grid.gap-10.px-6.py-10.sm:px-10.sm:py-14.lg:items-end.lg:px-14{class: "lg:grid-cols-[1fr_auto]"}
        .max-w-3xl
          %p.mb-4.text-xs.font-bold.uppercase.text-primary{class: "tracking-[0.24em]"}
            Seatwise · UI foundations
          %h1.text-4xl.font-black.tracking-tight.sm:text-6xl
            A thoughtful system
            %br.hidden.sm:block/
            for finding your place.
          %p.mt-5.max-w-2xl.text-base.leading-7.sm:text-lg{class: "text-neutral-content/70"}
            A practical reference for the Seatwise portal: calm surfaces, clear status, accessible
            controls, and booking patterns built with Rails, Tailwind, and daisyUI.
        .flex.flex-wrap.gap-3
          = button "Explore components", variant: :primary, href: "#components"
          = button "View foundations",                                     variant: :ghost,                                               href: "#foundations",                                          class: "border border-neutral-content/25 text-neutral-content"
      .grid.border-t.sm:grid-cols-3{class: "border-neutral-content/10"}
        .px-6.py-4.sm:px-10
          %p.text-xs.uppercase.tracking-widest{class: "text-neutral-content/50"} Principle
          %p.mt-1.font-semibold Clarity before decoration
        .border-t.px-6.py-4.sm:border-l.sm:border-t-0.sm:px-10{class: "border-neutral-content/10"}
          %p.text-xs.uppercase.tracking-widest{class: "text-neutral-content/50"} Color
          %p.mt-1.font-semibold Semantic and adaptable
        .border-t.px-6.py-4.sm:border-l.sm:border-t-0.sm:px-10{class: "border-neutral-content/10"}
          %p.text-xs.uppercase.tracking-widest{class: "text-neutral-content/50"} Components
          %p.mt-1.font-semibold Composable by default
    %section.space-y-5.scroll-mt-8#foundations{aria: { labelledby: "foundations-heading" }}
      = section_heading kicker: "01 · Foundations",                                                     title: "A flexible visual language",                                                            description:                                                                                    "Use theme tokens for color so every component stays legible when the active theme changes.", heading_id: "foundations-heading"
      .grid.gap-5{class: "lg:grid-cols-[1.35fr_0.65fr]"}
        = card body_class: "gap-5" do
          .flex.items-center.justify-between.gap-3
            %div
              = card_title "Semantic palette"
              %p.text-sm{class: "text-base-content/60"}
                Status and brand colors with matching foregrounds.
            = badge "Theme-aware", style: :ghost
          .grid.grid-cols-2.gap-3.sm:grid-cols-4
            - [["Primary", "bg-primary", "text-primary-content"], ["Secondary", "bg-secondary", "text-secondary-content"], ["Accent", "bg-accent", "text-accent-content"], ["Neutral", "bg-neutral", "text-neutral-content"], ["Info", "bg-info", "text-info-content"], ["Success", "bg-success", "text-success-content"], ["Warning", "bg-warning", "text-warning-content"], ["Error", "bg-error", "text-error-content"]].each do |name, color_class, text_class|
              .overflow-hidden.rounded-box.border.border-base-300.bg-base-100
                %div{class: "flex h-16 items-end p-3 #{color_class} #{text_class}"}
                  %span.text-xs.font-semibold= name
                .px-3.py-2
                  %code.text-xs{class: "text-base-content/60"}<= color_class
          .grid.gap-3.sm:grid-cols-3
            - [["Canvas", "bg-base-100", "text-base-content"], ["Subtle surface", "bg-base-200", "text-base-content"], ["Raised edge", "bg-base-300", "text-base-content"]].each do |name, color_class, text_class|
              %div{class: "flex items-center justify-between rounded-box border border-base-300 p-3 #{color_class} #{text_class}"}
                %span.text-sm.font-medium= name
                %code.text-xs.opacity-60<= color_class
        = card title: "Type scale", description: "A compact hierarchy keeps event details easy to scan." do
          .mt-2.space-y-4
            %div
              %p.text-3xl.font-black.tracking-tight Display
              %code.text-xs{class: "text-base-content/50"}< text-3xl / font-black
            %div
              %p.text-xl.font-bold.tracking-tight Section heading
              %code.text-xs{class: "text-base-content/50"}< text-xl / font-bold
            %div
              %p.text-base.font-medium Body copy for readable details.
              %code.text-xs{class: "text-base-content/50"}< text-base / font-medium
            %div
              %p.text-sm{class: "text-base-content/60"} Supporting information and metadata
              %code.text-xs{class: "text-base-content/50"}< text-sm / muted
    %section.space-y-5.scroll-mt-8#components{aria: { labelledby: "components-heading" }}
      = section_heading kicker: "02 · Components", title: "Useful building blocks",           heading_id: "components-heading"
      .grid.gap-5.lg:grid-cols-2
        = card title: "Actions",                                         description: "Reserve emphasis for the next meaningful step.", body_class: "gap-5" do
          .flex.flex-wrap.items-center.gap-2
            = button "Primary action", variant: :primary
            = button "Default action"
            = button "Outline", variant: :outline
            = button "Quiet action", variant: :ghost
          .flex.flex-wrap.items-center.gap-2.border-t.border-base-200.pt-4
            = button "Compact", variant: :primary, size: :sm
            = button variant: :outline, class: "btn-square", aria: { label: "Add to favorites" } do
              = lucide "heart", class: "size-4"
            = button "Unavailable", disabled: true, class: "btn-disabled", aria: { disabled: true }, tabindex: -1
        = card title: "Status",                                                description: "Pair color with direct labels for quick recognition.", body_class: "gap-5" do
          .flex.flex-wrap.gap-2
            = status_badge "Available", variant: :success
            = status_badge "On hold", variant: :warning
            = status_badge "Unavailable", variant: :error
            = status_badge "Confirmed", variant: :info
            = badge "General admission", style: :outline
          = status_alert title: "Your seats are held", description: "Complete checkout within 5 minutes to confirm the reservation.", icon: "info"
        = card title: "Form controls", description: "Keep labels visible and group related choices.", body_class: "gap-5" do
          .grid.gap-4.sm:grid-cols-2
            %label.form-control.w-full
              %span.label-text.mb-2.font-medium Search events
              %input.input.input-bordered.w-full{"aria-label" => "Search events", placeholder: "Artist, venue, or event", type: "search"}/
            %label.form-control.w-full
              %span.label-text.mb-2.font-medium Date range
              %select.select.select-bordered.w-full{aria: { label: "Date range" }}
                %option Any upcoming date
                %option This week
                %option This month
          %label.label.cursor-pointer.justify-start.gap-3
            %input.checkbox.checkbox-primary{type: "checkbox"}/
            %span.label-text Email me when more seats open
        = card title: "Surface and selection",                                    description: "Use subtle elevation to distinguish interactive groups.", body_class: "gap-5" do
          .rounded-box.border.border-base-300.bg-base-200.p-4
            .flex.items-center.justify-between.gap-3
              %div
                %p.font-semibold Mezzanine · Row B
                %p.mt-1.text-sm{class: "text-base-content/60"} 12 seats available
              = badge "Open", variant: :success, style: :soft
            .mt-4.flex.flex-wrap.gap-2
              = button "Row A", size: :sm
              = button "Row B", size: :sm, variant: :primary, aria: { pressed: true }
              = button "Row C", size: :sm
    %section.space-y-5.scroll-mt-8#patterns{aria: { labelledby: "patterns-heading" }}
      = section_heading kicker: "03 · Product patterns",                                             title: "The event card, in context",                                                         description:                                                                                 "Show the details guests need to decide: when, where, and how much availability remains.", heading_id: "patterns-heading"
      .grid.gap-5{class: "lg:grid-cols-[1.4fr_0.6fr]"}
        = card element: :article,                                                         body: false,                                                                    card_class: "card-border overflow-hidden bg-base-100 shadow-sm sm:card-side" do
          .relative.grid.min-h-56.place-items-center.overflow-hidden.bg-gradient-to-br{class: "from-primary/25 via-secondary/15 to-accent/25 sm:w-2/5"}
            .absolute.-left-10.-top-10.size-48.rounded-full.blur-2xl{"aria-hidden" => "true", class: "bg-primary/20"}
            .relative.grid.size-32.place-items-center.rounded-full.border.text-5xl.font-black.tracking-tighter{class: "border-base-content/10 bg-base-100/70 text-base-content/70"}
              M
            = badge "Illustrative · Nov 20", variant: :neutral, extra_class: "absolute left-4 top-4"
            = badge "18 seats open", variant: :success, extra_class: "absolute bottom-4 left-4"
          = card_body body_class: "justify-between gap-5 sm:p-7" do
            %div
              %p.text-sm.font-medium{class: "text-base-content/55"} 7:30 PM · The Grand Room
              = card_title "Midnight in the Garden", extra_class: "mt-2 text-2xl"
              %p.mt-2.max-w-lg.text-sm.leading-6{class: "text-base-content/65"}
                An intimate live performance in a beautifully restored downtown venue.
            .flex.flex-wrap.items-center.justify-between.gap-3.border-t.border-base-200.pt-4
              %span.text-sm{class: "text-base-content/60"} 72 seats in this room
              = button variant: :primary, href: events_path do
                = "Explore event #{lucide "arrow-right", class: "size-4"}"
        = card element: :aside,                                    card_class: "bg-primary text-primary-content shadow-sm", body_class: "justify-between" do
          %div
            = badge "Interaction principle",                                                      extra_class: "border-primary-content/20 bg-primary-content/10 text-primary-content"
            %h3.mt-5.text-2xl.font-bold.tracking-tight Make the next step obvious.
            %p.mt-3.text-sm.leading-6.opacity-80
              One clear primary action per decision point. Keep supporting actions visible, calm,
              and easy to understand.
          = button variant: :ghost,                                                                href: "#components",                                                                   class: "mt-6 justify-between border border-primary-content/25 text-primary-content" do
            = "Back to components #{lucide "arrow-up", class: "size-4"}"
    %section.space-y-5.scroll-mt-8#booking-flow{aria: { labelledby: "booking-flow-heading" }}
      = section_heading kicker: "04 · Reservation flow",                                                                title: "One step at a time, with context",                                                                      description:                                                                                                    "Keep the current step clear, preserve the booking summary, and explain what happens after each submission.", heading_id: "booking-flow-heading"
      = card body_class: "gap-7 p-5 sm:p-8" do
        .flex.flex-wrap.items-start.justify-between.gap-4
          %div
            = badge "Step 2 of 5", variant: :primary, style: :soft
            %h3.mt-3.text-xl.font-bold Your contact details
            %p.mt-1.text-sm{class: "text-base-content/60"}
              We’ll use this email for your hold and booking updates.
          = badge "Hold active · 04:32 left", variant: :warning, style: :soft
        = step_indicator label: "Booking progress",                                     steps: ["Choose seats", "Your details", "Review", "Payment", "Confirmation"], current_step: 2
        .grid.gap-8{class: "lg:grid-cols-[1fr_0.72fr]"}
          %form.space-y-5{aria: { label: "Example reservation contact form" }}
            %fieldset.fieldset.rounded-box.border.border-base-300.p-4.sm:p-5
              %legend.fieldset-legend.px-1.text-base Contact information
              = field label: "Email address", name: "reservation[email]", type: "email", value: "alex@", required: true, hint: "Your booking confirmation will be sent here.", error: "Enter a complete email address."
              = field label: "Name (optional)", name: "reservation[name]", type: "text", placeholder: "Name on the booking", input_class: "mt-3"
              = field label: "Phone (optional)", name: "reservation[phone]", type: "tel", value: "+1 416 555 0142", hint: "Used only for urgent event updates.", input_class: "input-success mt-3"
              %label.label.mt-2.cursor-pointer.justify-start.gap-3
                %input.checkbox.checkbox-primary{checked: "checked", type: "checkbox"}/
                %span.label-text Send me event updates and booking changes
            .flex.flex-wrap.justify-between.gap-3
              = button variant: :ghost do
                = lucide "arrow-left", class: "size-4"
                Back to seats
              = button variant: :primary do
                = "Continue to review #{lucide "arrow-right", class: "size-4"}"
          %aside.space-y-4
            = reservation_summary event_name: "Midnight in the Garden", event_date: "Fri, Nov 20 · 7:30 PM", row_id: "front_a", row_label: "A", seat_start: 8, seat_end: 10, status_label: "Held", status_variant: :warning, hold_deadline: "7:42 PM", total: "$84.00", editable: true
            = status_alert title: "Seats are held temporarily", description: "Checkout does not extend the hold deadline.", variant: :warning, icon: "clock-3"
      .grid.gap-5{class: "lg:grid-cols-[1fr_0.8fr]"}
        = card title: "Reservation lifecycle",                                           description: "A timeline distinguishes user progress from reservation state.", body_class: "gap-5" do
          .grid.gap-5.md:items-start{class: "md:grid-cols-[0.75fr_1.25fr]"}
            %aside.rounded-box.border.border-base-300.bg-base-200.p-4
              %p.text-xs.font-bold.uppercase.tracking-wider{class: "text-base-content/50"}
                Active reservation
              %p.mt-2.font-semibold Midnight in the Garden
              %p.mt-1.text-sm{class: "text-base-content/60"} Fri, Nov 20 · 7:30 PM
              .my-4.border-t.border-base-300
              .flex.items-center.justify-between.gap-3
                %span.text-sm{class: "text-base-content/60"} Seats held
                = badge "04:32 left", variant: :warning, style: :soft
              %p.mt-2.text-sm.font-medium Row A · 8–10
              %p.font-mono.text-xs{class: "text-base-content/55"} row_id: front_a
              .mt-4.flex.justify-between.border-t.border-base-300.pt-3.text-sm
                %span{class: "text-base-content/60"} Estimated total
                %span.font-semibold $84.00
            %ul.timeline.timeline-vertical.timeline-compact.timeline-snap-icon.mx-0.w-full.max-w-none
              %li
                .timeline-middle.text-success
                  = lucide "circle-check", class: "size-5", decorative: false, aria: { label: "Complete" }
                .timeline-end.timeline-box.w-full
                  %time.text-xs{class: "text-base-content/50"} 7:37 PM
                  %p.font-semibold Choose seats
                  %p.text-sm{class: "text-base-content/60"} Row A · seats 8–10 · reservation held.
                %hr.bg-success/
              %li
                %hr.bg-success/
                .timeline-middle.text-primary
                  = lucide "circle-dot", class: "size-5", decorative: false, aria: { label: "Current step" }
                .timeline-end.timeline-box.w-full.border-primary
                  %time.text-xs{class: "text-base-content/50"} Now
                  %p.font-semibold Your details
                  %p.text-sm{class: "text-base-content/60"}
                    Add an email so we can send the booking update.
                %hr/
              %li
                %hr/
                .timeline-middle{class: "text-base-content/40"}
                  = lucide "circle", class: "size-5", decorative: false, aria: { label: "Upcoming" }
                .timeline-end.timeline-box.w-full
                  %p.font-semibold Review
                  %p.text-sm{class: "text-base-content/60"}
                    Check the reservation and total before payment.
                %hr/
              %li
                %hr/
                .timeline-middle{class: "text-base-content/40"}
                  = lucide "circle", class: "size-5", decorative: false, aria: { label: "Upcoming" }
                .timeline-end.timeline-box.w-full
                  %p.font-semibold Payment
                  %p.text-sm{class: "text-base-content/60"}
                    Complete checkout before the 7:42 PM hold deadline.
                %hr/
              %li
                %hr/
                .timeline-middle{class: "text-base-content/40"}
                  = lucide "circle", class: "size-5", decorative: false, aria: { label: "Upcoming" }
                .timeline-end.timeline-box.w-full
                  %p.font-semibold Confirmation
                  %p.text-sm{class: "text-base-content/60"}
                    Your booking reference and seats appear after payment succeeds.
        = card title: "Submission states",                               description: "Separate examples show one response at a time.", body_class: "gap-5" do
          .grid.gap-3.sm:grid-cols-2
            .rounded-box.border.p-4{class: "border-error/30"}
              = badge "Availability conflict", variant: :error, style: :soft, extra_class: "mb-3"
              = status_alert title: "Seats just became unavailable",             description: "Refresh availability, then choose another block.", variant: :error,                                                 icon: "triangle-alert",                                          soft: true,                                                      action: button("Refresh", variant: :error, size: :sm)
            .rounded-box.border.p-4{class: "border-error/30"}
              = badge "Payment retry", variant: :error, style: :soft, extra_class: "mb-3"
              = status_alert title: "Payment didn’t complete",                        description: "Your hold is still active. Retry before the deadline.", variant: :error,                                                      icon: "triangle-alert",                                               soft: true,                                                           action: button("Retry", variant: :error, size: :sm)
            .rounded-box.border.p-4{class: "border-warning/30"}
              = badge "Hold expiry", variant: :warning, style: :soft, extra_class: "mb-3"
              = status_alert title: "Hold expired",                                    description: "No payment was taken. Start again to select new seats.", variant: :warning,                                                     icon: "clock-3",                                                       soft: true
            .rounded-box.border.border-base-300.p-4
              = badge "In progress", style: :ghost, extra_class: "mb-3"
              .flex.items-center.gap-3.rounded-box.bg-base-200.p-4
                %span.loading.loading-spinner.loading-sm.text-primary{aria: { hidden: "true" }}
                %div
                  %p.font-semibold Starting secure checkout
                  %p.text-sm{class: "text-base-content/60"} Preparing the payment session.
            .rounded-box.border.p-4.sm:col-span-2{class: "border-success/30"}
              = badge "Success", variant: :success, style: :soft, extra_class: "mb-3"
              = status_alert title: "Reservation confirmed",                description: "Your booking reference and seats are ready.", variant: :success,                                          icon: "circle-check",                                       soft: true
      .grid.gap-5.lg:grid-cols-2
        = card element: :article, body_class: "gap-5" do
          .flex.items-start.justify-between.gap-3
            %div
              = badge "Step 3 · Review", variant: :primary, style: :soft
              = card_title "Check your reservation", extra_class: "mt-3"
              %p.text-sm{class: "text-base-content/60"}
                Give guests a final chance to verify the held seats and price.
            = lucide "clipboard-check", class: "size-6 text-primary"
          %dl.divide-y.divide-base-200.rounded-box.border.border-base-300.px-4.text-sm
            .flex.justify-between.gap-4.py-3
              %dt{class: "text-base-content/60"} Event
              %dd.text-right.font-medium
                Midnight in the Garden
                %br/
                %span.font-normal{class: "text-base-content/55"} Fri, Nov 20 · 7:30 PM
            .flex.justify-between.gap-4.py-3
              %dt{class: "text-base-content/60"} Seats
              %dd.text-right.font-medium
                Row A · 8–10
                %br/
                %span.font-mono.text-xs{class: "text-base-content/55"} row_id: front_a
            .flex.justify-between.gap-4.py-3
              %dt{class: "text-base-content/60"} Total
              %dd.font-semibold $84.00
          %label.label.cursor-pointer.justify-start.gap-3
            %input.checkbox.checkbox-primary{type: "checkbox"}/
            %span.label-text I’ve checked the event and seat details
          .flex.flex-wrap.justify-between.gap-3.border-t.border-base-200.pt-4
            = button "Edit details", variant: :ghost
            = button variant: :primary do
              = "Continue to payment #{lucide "arrow-right", class: "size-4"}"
        = card element: :article, body_class: "gap-5" do
          .flex.items-start.justify-between.gap-3
            %div
              = badge "Step 4 · Payment", variant: :primary, style: :soft
              = card_title "Secure checkout", extra_class: "mt-3"
              %p.text-sm{class: "text-base-content/60"}
                Show the amount and hold deadline beside payment fields.
            = lucide "shield-check", class: "size-6 text-primary"
          = status_alert title: "$84.00 due · seats held until 7:42 PM", description: "", variant: :info, icon: "clock-3", soft: true, role: "status"
          %form.space-y-4{aria: { label: "Example payment form" }}
            = field label: "Name on card", name: "payment[name]", type: "text", value: "Alex Rivera", required: true
            = field label: "Card number", name: "payment[number]", type: "text", value: "•••• •••• •••• 4242", required: true, hint: "Demo value only · card details are handled by the payment provider."
            .grid.grid-cols-2.gap-3
              = field label: "Expiry", name: "payment[expiry]", type: "text", placeholder: "MM / YY", required: true
              = field label: "Security code", name: "payment[cvc]",         type: "password",             placeholder: "CVC",           required: true
            .flex.flex-wrap.justify-between.gap-3.border-t.border-base-200.pt-4
              = button "Back to review", variant: :ghost
              = button variant: :primary do
                = lucide "lock-keyhole", class: "size-4"
                Pay $84.00
    %section.space-y-5.scroll-mt-8#model-examples{aria: { labelledby: "model-examples-heading" }}
      = section_heading kicker: "05 · Model examples",                                              title: "Small views around the domain",                                                     description:                                                                                "These are design patterns for focused tasks and records, not complete admin platforms.", heading_id: "model-examples-heading"
      .grid.gap-5.md:grid-cols-2.xl:grid-cols-3
        = card element: :article, body_class: "gap-4" do
          = record_heading title: "Venue · layout rows", kind: "Venue"
          %p.text-sm{class: "text-base-content/60"}
            Edit the reusable layout; event inventory gets its own published snapshot.
          = data_table headers: %w[row_id Label Order Seats],            rows: [                                                      [tag.span("front_1", class: "font-mono"), "A", "1", "12"], [tag.span("middle_1", class: "font-mono"), "B", "2", "16"] ]
          = button "Add a row", size: :sm, variant: :outline, class: "self-start"
        = card element: :article, body_class: "gap-4" do
          = record_heading title: "Event · publish", kind: "Event"
          %p.text-sm{class: "text-base-content/60"}
            Choose a venue and schedule, then review the inventory snapshot.
          %form.space-y-3{aria: { label: "Example event form" }}
            = field label: "Event name",       name: "event[name]",             type: "text",                    value: "Midnight in the Garden", input_class: "input-sm"
            .grid.grid-cols-2.gap-3
              = field label: "Starts",     name: "event[starts_at]",  type: "datetime-local",    value: "2026-11-20T19:30", input_class: "input-sm"
              %label.form-control
                %span.label-text.mb-1.font-medium Venue
                %select.select.select-bordered.select-sm.w-full
                  %option The Grand Room
            .rounded-box.bg-base-200.p-3.text-sm
              %span.font-semibold Snapshot preview
              %span.ml-2{class: "text-base-content/60"} 3 rows · 72 seats
            = button "Review event", type: "button", size: :sm, variant: :primary
        = card element: :article, body_class: "gap-4" do
          = record_heading title: "Customer · profile", kind: "Customer"
          %p.text-sm{class: "text-base-content/60"}
            A customer can hold reservations before verifying their email.
          .rounded-box.border.border-base-300.p-4
            .flex.items-center.gap-3
              .avatar.placeholder.shrink-0
                .flex.size-11.items-center.justify-center.rounded-full.bg-secondary.text-secondary-content
                  %span.text-sm.font-semibold.leading-none AR
              .min-w-0
                %p.font-semibold Alex Rivera
                %p.text-sm{class: "text-base-content/60"} alex@example.com
            .mt-4.flex.flex-wrap.items-center.gap-2
              = badge "Email unverified", variant: :warning, style: :soft
              = badge "2 reservations", style: :ghost
          .flex.justify-between.text-sm
            %span{class: "text-base-content/60"} Recent payment
            %span.font-medium via reservation
          = button "View reservations", size: :sm, class: "self-start"
        = card element: :article, body_class: "gap-4" do
          = record_heading title: "Reservation · detail", kind: "Reservation"
          %p.text-sm{class: "text-base-content/60"}
            Show API vocabulary and explain which actions remain available.
          %dl.space-y-3.rounded-box.border.border-base-300.p-4.text-sm
            .flex.justify-between.gap-4
              %dt{class: "text-base-content/60"} Reference
              %dd.font-mono.font-semibold res_42
            .flex.justify-between.gap-4
              %dt{class: "text-base-content/60"} row_id
              %dd.font-mono front_a
            .flex.justify-between.gap-4
              %dt{class: "text-base-content/60"} seat_start – seat_end
              %dd.font-semibold 5 – 6
            .flex.justify-between.gap-4
              %dt{class: "text-base-content/60"} Status
              %dd= status_badge "Confirmed", variant: :success
          .flex.gap-2
            = button "View event", size: :sm
            = button "Get help", size: :sm, variant: :outline
        = card element: :article, body_class: "gap-4" do
          = record_heading title: "Payment · attempt", kind: "Payment"
          %p.text-sm{class: "text-base-content/60"}
            Payments belong to reservations; the customer is reached through that reservation.
          = data_table headers: ["External ID", "Reservation", "Status"], rows: [                                                       [                                                           tag.span("pay_42", class: "font-mono"),                   tag.span("res_42", class: "font-mono"),                   status_badge("Pending", variant: :info, small: true)      ],                                                          [                                                           tag.span("pay_41", class: "font-mono"),                   tag.span("res_41", class: "font-mono"),                   status_badge("Succeeded", variant: :success, small: true) ],                                                          [                                                           tag.span("pay_40", class: "font-mono"),                   tag.span("res_40", class: "font-mono"),                   status_badge("Failed", variant: :error, small: true)      ]                                                           ]
          .flex.gap-2
            = button "Retry pending", size: :sm, variant: :primary
            = button "View reservation", size: :sm, variant: :ghost
        = card element: :article, body_class: "gap-4", card_class: "md:col-span-2 xl:col-span-3" do
          .flex.flex-wrap.items-center.justify-between.gap-3
            %div
              = card_title "Reservation list"
              %p.mt-1.text-sm{class: "text-base-content/60"}
                A wider operational view keeps reference, seats, event, and status together.
            = badge "Operations", style: :outline
          .flex.flex-wrap.gap-2
            %input.input.input-bordered.input-sm.min-w-40.grow{"aria-label" => "Search reservations", placeholder: "Search reference or email", type: "search"}/
            %select.select.select-bordered.select-sm{aria: { label: "Filter reservation status" }}
              %option All statuses
              %option Held
              %option Confirmed
              %option Expired
          = data_table headers: [                                                                  "Reference",                                                                         "Event",                                                                             "Customer",                                                                          "Seats",                                                                             "Event time",                                                                        "Status",                                                                            tag.span("Actions", class: "sr-only")                                                ],                                                                                     zebra: true,                                                                           rows: [                                                                                [                                                                                    tag.span("res_1042", class: "font-mono"),                                          "Midnight in the Garden",                                                          safe_join(                                                                         [                                                                                "Alex Rivera",                                                                 tag.span(                                                                      "alex@example.com",                                                          class: "block text-xs font-normal text-base-content/55"                      )                                                                              ]                                                                                ),                                                                                 safe_join(                                                                         [                                                                                tag.span("Row A · 8–10", class: "font-semibold"),                              tag.span("front_a", class: "block font-mono text-xs text-base-content/55")     ]                                                                                ),                                                                                 "Fri, Nov 20 · 7:30 PM",                                                           status_badge("Held", variant: :warning, small: true),                              button(variant: :ghost, size: :xs, aria: { label: "Open reservation res_1042" }) { lucide "arrow-up-right", class: "size-4"                                         }                                                                                  ],                                                                                   [                                                                                    tag.span("res_1041", class: "font-mono"),                                          "Blue Hour Quartet",                                                               safe_join(                                                                         [                                                                                "Sam Kim",                                                                     tag.span(                                                                      "sam@example.com",                                                           class: "block text-xs font-normal text-base-content/55"                      )                                                                              ]                                                                                ),                                                                                 safe_join(                                                                         [                                                                                tag.span("Row C · 8–10", class: "font-semibold"),                              tag.span("row_c", class: "block font-mono text-xs text-base-content/55")       ]                                                                                ),                                                                                 "Sat, Nov 21 · 8:00 PM",                                                           status_badge("Confirmed", variant: :success, small: true),                         button(variant: :ghost, size: :xs, aria: { label: "Open reservation res_1041" }) { lucide "arrow-up-right", class: "size-4"                                         }                                                                                  ],                                                                                   [                                                                                    tag.span("res_1040", class: "font-mono"),                                          "Late Show Sessions",                                                              safe_join(                                                                         [                                                                                "Jules Morgan",                                                                tag.span(                                                                      "jules@example.com",                                                         class: "block text-xs font-normal text-base-content/55"                      )                                                                              ]                                                                                ),                                                                                 safe_join(                                                                         [                                                                                tag.span("Row B · 1–2", class: "font-semibold"),                               tag.span("row_b", class: "block font-mono text-xs text-base-content/55")       ]                                                                                ),                                                                                 "Sun, Nov 22 · 6:00 PM",                                                           status_badge("Expired", variant: :ghost, small: true),                             button(variant: :ghost, size: :xs, aria: { label: "Open reservation res_1040" }) { lucide "arrow-up-right", class: "size-4"                                         }                                                                                  ]                                                                                    ]
          .flex.items-center.justify-between.text-xs{class: "text-base-content/55"}
            %span Showing 1–3 of 24 reservations
            .join
              = button "«", size: :xs, class: "join-item", aria: { label: "Previous page" }
              = button "1", size: :xs, class: "join-item btn-active", aria: { current: "page" }
              = button "2", size: :xs, class: "join-item"
              = button "»", size: :xs, class: "join-item", aria: { label: "Next page" }
      .grid.gap-4.md:grid-cols-3
        = card card_class: "border border-base-300 bg-base-100", body_class: "p-5" do
          = badge "Loading", style: :ghost, extra_class: "self-start"
          .skeleton.mt-2.h-4{class: "w-2/3"}
          .skeleton.h-4.w-full
          .skeleton.h-4{class: "w-4/5"}
        = card card_class: "border border-base-300 bg-base-100", body_class: "items-center p-5 text-center" do
          = badge "Empty", style: :ghost
          %h3.mt-1.font-semibold No reservations yet
          %p.text-sm{class: "text-base-content/60"} New bookings will appear here.
          = button "Browse events", size: :sm, href: events_path
        = status_alert title: "Couldn’t load reservations",   description: "Your data is unchanged. Try again.",  variant: :error,                                    icon: "triangle-alert",                             extra_class: "items-start",                         action: button("Retry", variant: :error, size: :sm)
    %footer.flex.flex-col.gap-3.border-t.border-base-300.pt-6.text-sm.sm:flex-row.sm:items-center.sm:justify-between{class: "text-base-content/55"}
      %p Seatwise · Design system reference
      .flex.items-center.gap-4
        = link_to "Browse events", events_path, class: "link link-hover"
        = link_to "API health", "/api/v1/up", class: "link link-hover"
