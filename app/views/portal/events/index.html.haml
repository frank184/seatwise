- content_for :title, "Discover events · Seatwise"
.min-h-full{
  class: "bg-base-200/60",
  "data-controller": "portal--events",
  "data-action": "portal--availability:updated->portal--events#availabilityUpdated",
  "data-events-index": ""
}
  %main.mx-auto.max-w-7xl.space-y-9.px-4.py-5.sm:px-8.sm:py-8
    %section.relative.isolate.overflow-hidden.rounded-box.bg-neutral.text-neutral-content.shadow-xl
      .absolute.-right-16.-top-24.-z-10.size-96.rounded-full.blur-3xl{
        "aria-hidden": "true",
        class: "bg-primary/25"
      }

      .grid.gap-5.px-6.py-7.sm:px-10.sm:py-9.lg:items-center.lg:px-14{
        class: "lg:grid-cols-[1fr_auto]"
      }
        .max-w-3xl
          %p.mb-3.text-xs.font-bold.uppercase.text-primary{class: "tracking-[0.24em]"}
            Live experiences, thoughtfully seated
          %h1.text-3xl.font-black.tracking-tight.sm:text-5xl A good night starts with a seat.
          %p.mt-3.max-w-2xl.text-sm.leading-6.sm:text-base{class: "text-neutral-content/70"}
            Find a performance worth leaving home for. Then find a seat that feels like yours.
        .flex.flex-wrap.gap-2.lg:justify-end
          = badge "Thoughtful seat selection", style: :outline, extra_class: "border-neutral-content/25 text-neutral-content"
          %span.badge.badge-outline.text-neutral-content#event-count{
            class: "w-32 justify-center whitespace-nowrap border-neutral-content/25",
            "aria-live": "polite"
          }
            Loading events…

    %section.scroll-mt-24.space-y-6{"aria-labelledby": "events-heading"}
      = section_heading kicker: "The calendar", title: "Find your event", description: "Explore performances and see what’s still open in the room.", heading_id: "events-heading"
      - query_params = params[:q]
      - search_term = query_params.is_a?(ActionController::Parameters) ? query_params[:name_or_venue_name_cont] : query_params
      - selected_venue = query_params[:venue_id_eq] if query_params.is_a?(ActionController::Parameters)
      - selected_when = params[:when].presence || "upcoming"
      - selected_sort = params[:sort].presence || "soonest"
      - sort_by_name = ["name", "name_desc"].include?(selected_sort)
      - sort_descending = ["latest", "name_desc"].include?(selected_sort)
      = form_with url: root_path, method: :get, id: "event-filters", class: "space-y-3 rounded-box border border-base-300 bg-base-100 p-3 sm:p-4", data: { action: "submit->portal--events#submitFilters" } do |form|
        = form.hidden_field :when, value: selected_when, id: "event-date-filter"
        = form.hidden_field :sort, value: selected_sort, id: "event-sort-filter"
        .grid.gap-3{class: "md:grid-cols-[minmax(0,1fr)_12rem]"}
          %label.input.input-bordered.flex.w-full.min-w-0.items-center.gap-2.md:flex-1
            = lucide "search", class: "size-4 text-base-content/45"
            = form.search_field "q[name_or_venue_name_cont]", value: search_term, class: "grow", placeholder: "Search events or venues", aria: { label: "Search events or venues" }
          = form.label :q_venue_id_eq, "Venue", class: "sr-only"
          = form.select "q[venue_id_eq]", options_for_select([["All venues", ""]] + @venues.map { |venue| [venue.name, venue.id] }, selected_venue), {}, class: "select select-bordered w-full", aria: { label: "Filter by venue" }, data: { action: "change->portal--events#filtersChanged" }
        .flex.flex-col.gap-3.border-t.border-base-200.pt-3.sm:flex-row.sm:items-center.sm:justify-between
          %fieldset
            %legend.sr-only When to browse
            .join{"aria-label": "When to browse"}
              - [["Coming soon", "upcoming"], ["All", "all"], ["Past events", "past"]].each do |label, value|
                %button.btn.btn-sm.join-item{
                  type: "button",
                  class: ("btn-primary" if selected_when == value),
                  aria: { pressed: selected_when == value },
                  data: { action: "click->portal--events#selectWhen", when: value }
                }
                  = label
          .flex.items-center.gap-2.sm:ml-auto
            %span.text-xs.font-semibold{class: "text-base-content/60"} Sort by
            .join
              %button.btn.btn-sm.join-item{
                type: "button",
                class: ("btn-primary" unless sort_by_name),
                aria: {
                  pressed: !sort_by_name,
                  label: (
      if sort_by_name
        "Sort by date, soonest first"
      else
        (sort_descending ? "Date, latest first" : "Date, soonest first")
      end
    )
                },
                title: (
    if !sort_by_name && sort_descending
      "Date: latest first"
    else
      "Date: soonest first"
    end
  ),
                data: { action: "click->portal--events#selectSort", sort_key: "date" }
              }
                Date
                %span.grid.size-4.shrink-0.place-items-center{
                  class: ("invisible" if sort_by_name),
                  aria: { hidden: "true" },
                  data: { sort_indicator: "date" }
                }
                  %span{hidden: !sort_descending, data: { sort_direction: "descending" }}
                    = lucide "arrow-down-wide-narrow", class: "size-4"
                  %span{hidden: sort_descending, data: { sort_direction: "ascending" }}
                    = lucide "arrow-up-wide-narrow", class: "size-4"
              %button.btn.btn-sm.join-item{
                type: "button",
                class: ("btn-primary" if sort_by_name),
                aria: {
                  pressed: sort_by_name,
                  label: (
      if sort_by_name
        (sort_descending ? "Name, Z to A" : "Name, A to Z")
      else
        "Sort by name, A to Z"
      end
    )
                },
                title: (sort_by_name && sort_descending ? "Name: Z to A" : "Name: A to Z"),
                data: { action: "click->portal--events#selectSort", sort_key: "name" }
              }
                Name
                %span.grid.size-4.shrink-0.place-items-center{
                  class: ("invisible" unless sort_by_name),
                  aria: { hidden: "true" },
                  data: { sort_indicator: "name" }
                }
                  %span{hidden: !sort_descending, data: { sort_direction: "descending" }}
                    = lucide "arrow-down-wide-narrow", class: "size-4"
                  %span{hidden: sort_descending, data: { sort_direction: "ascending" }}
                    = lucide "arrow-up-wide-narrow", class: "size-4"
            = button "Search", type: "submit", variant: :neutral, class: "w-24 shrink-0"
      .hidden.grid.gap-5.md:grid-cols-2.xl:grid-cols-3#events-loading{
        "aria-live": "polite",
        hidden: ""
      }
        - 3.times do
          = card card_class: "border border-base-300 bg-base-100", body_class: "gap-4 p-0" do
            .skeleton.h-44.rounded-b-none
            .space-y-3.p-5
              .skeleton.h-4{class: "w-1/3"}
              .skeleton.h-6{class: "w-2/3"}
              .skeleton.h-10.w-full
      #events-error{hidden: ""}
      #events-empty{hidden: ""}
      .grid.gap-5.md:grid-cols-2.xl:grid-cols-3#events-list{"aria-live": "polite", hidden: ""}
      %nav.flex.items-center.justify-center.gap-4#events-pagination{
        "aria-label": "Event pages",
        hidden: ""
      }
        .join
          = button "Previous", size: :sm, class: "join-item", data: { action: "click->portal--events#previousPage", page_previous: true }
          = button "Next", size: :sm, class: "join-item", data: { action: "click->portal--events#nextPage", page_next: true }
  %template#event-card-template
    = card element: :article, body: false, card_class: "overflow-hidden border border-base-300 bg-base-100 transition-shadow hover:shadow-xl" do
      %a.group.block.text-base-content.no-underline{"data-event-link": "", href: "#"}
        .relative.grid.h-44.place-items-center.overflow-hidden.bg-gradient-to-br{
          class: "from-primary/30 via-secondary/20 to-accent/30"
        }
          %span.grid.size-14.place-items-center.rounded-full.text-primary.shadow-sm{
            "aria-hidden": "true",
            class: "bg-base-100/75"
          }
            = lucide "music-2", class: "size-6"
          %span.badge.absolute.left-4.top-4{
            class: "border-base-100/70 bg-base-100/90",
            "data-event-date": ""
          }

          %span.badge.badge-outline.absolute.right-4.top-4{
            class: "border-base-100/70 bg-base-100/90",
            "data-event-past": "",
            hidden: ""
          }
            Past event
          %span.badge.absolute.bottom-4.left-4{
            class: "border border-base-content/25 bg-base-100 text-base-content",
            data: { event_availability_badge: "" }
          }
            = lucide "armchair", class: "size-3.5"
            %span{"data-event-availability": ""}
        = card_body body_class: "gap-3" do
          .flex.items-center.gap-2.text-sm.font-medium{class: "text-base-content/55"}
            %span{"data-event-time": ""}
            %span{"aria-hidden": "true"} ·
            %span{"data-event-venue": ""}
          %time.text-sm.text-primary{"data-event-relative-time": ""}
          %h3.card-title.text-xl{"data-event-name": ""}
          .flex.items-center.justify-between.border-t.border-base-200.pt-3
            %span.text-sm{class: "text-base-content/60", "data-event-capacity": ""}
            %span.btn.btn-sm.btn-primary
              = "Explore #{lucide "arrow-up-right", class: "size-4"}"
  %template#event-empty-template
    = card card_class: "border border-base-300 bg-base-100", body_class: "items-center py-14 text-center" do
      = lucide "calendar-search", class: "size-9 text-base-content/35"
      = card_title "No events found"
      %p.text-sm{class: "text-base-content/60"} Try another search or switch the date filter.
  %template#event-error-template
    = status_alert title: "Events could not load", description: "Check your connection and try again.", variant: :error, icon: "triangle-alert", action: button("Retry", variant: :error, size: :sm, data: { action: "click->portal--events#retry" })
  %template#event-page-number-template
    %button.btn.btn-sm.join-item{
      type: "button",
      data: { action: "click->portal--events#goToPage", page_number: true },
      aria: { label: "Page" }
    }
