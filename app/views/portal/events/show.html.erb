<% content_for :title, "Event details · Seatwise" %>
<div class="min-h-screen bg-base-200/60" data-controller="portal--events" data-event-show data-event-id="<%= @event_id %>" data-action="pointerup@window->portal--events#endSeatDrag pointercancel@window->portal--events#endSeatDrag">
  <%= render "header" %>
  <main class="mx-auto max-w-7xl space-y-6 px-4 py-5 sm:px-8 sm:py-8">
    <%= link_to root_path, class: "btn btn-ghost btn-sm" do %><%= lucide "arrow-left", class: "size-4" %> Back to events<% end %>
    <div id="event-loading" class="hidden space-y-6" aria-live="polite" hidden>
      <%= card card_class: "border border-base-300 bg-base-100", body_class: "gap-4" do %>
        <div class="skeleton h-8 w-1/3"></div><div class="skeleton h-5 w-1/2"></div><div class="skeleton h-24 w-full"></div>
      <% end %>
      <%= card card_class: "border border-base-300 bg-base-100", body_class: "gap-4" do %><div class="skeleton h-6 w-1/4"></div><div class="skeleton h-16 w-full"></div><% end %>
    </div>
    <div id="event-error" hidden></div>
    <div id="event-content" hidden>
      <%= card card_class: "overflow-hidden border border-base-300 bg-base-100", body_class: "gap-0 p-0" do %>
        <div class="grid lg:grid-cols-[1.1fr_0.9fr]">
          <div class="relative grid min-h-36 place-items-center overflow-hidden bg-gradient-to-br from-primary/10 via-base-200 to-secondary/15 lg:min-h-48">
            <span class="grid size-14 place-items-center rounded-full bg-base-100/80 text-primary shadow-sm" aria-hidden="true"><%= lucide "music-2", class: "size-6" %></span>
            <span data-detail-date class="badge badge-lg absolute bottom-6 left-6 border-base-100/70 bg-base-100/90"></span>
          </div>
          <div class="flex flex-col justify-center p-6 sm:p-10">
            <%= badge "Event details", variant: :primary, style: :outline, extra_class: "w-fit" %>
            <h1 data-detail-name class="mt-4 text-4xl font-black tracking-tight"></h1>
            <p data-detail-venue class="mt-3 text-lg text-base-content/65"></p>
            <div class="divider"></div>
            <dl class="grid grid-cols-2 gap-5 text-sm">
              <div><dt class="text-base-content/55">Doors &amp; show</dt><dd data-detail-start class="mt-1 font-semibold"></dd></div>
              <div><dt class="text-base-content/55">Ends around</dt><dd data-detail-end class="mt-1 font-semibold"></dd></div>
              <div><dt class="text-base-content/55">Room capacity</dt><dd data-detail-seats class="mt-1 font-semibold"></dd></div>
              <div><dt class="text-base-content/55">Currently open</dt><dd data-detail-open class="mt-1 font-semibold text-success"></dd></div>
            </dl>
            <div class="mt-7"><%= status_alert title: "Preview only", description: "Seat selection and checkout are not enabled yet. Availability may change.", variant: :info, icon: "info", soft: true %></div>
          </div>
        </div>
        <section class="border-t border-base-300 p-6 sm:p-10" aria-labelledby="seating-title">
          <div class="mb-5 flex flex-wrap items-end justify-between gap-3"><div><p class="text-sm font-semibold text-primary">The room</p><h2 id="seating-title" class="mt-1 text-2xl font-bold">Seating overview</h2></div><span class="text-sm text-base-content/55">Availability preview</span></div>
          <div data-detail-rows class="space-y-3"></div>
          <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-base-content/75"><span class="size-3 rounded-t-full border border-success bg-success/70"></span> Open <span class="ml-3 size-3 rounded-t-full border-2 border-dashed border-base-content/50 bg-base-300"></span> Held or reserved <span class="sr-only">Each seat also has a text label with its status.</span></div>
          <%= card card_class: "mt-6 border border-base-300 bg-base-100", body_class: "gap-3 sm:flex-row sm:items-center sm:justify-between" do %>
            <div>
              <h3 class="font-semibold">Your seat preview</h3>
              <p data-selection-count class="mt-1 text-sm text-base-content/60">Click or drag across up to 6 open seats.</p>
              <p data-selection-message class="mt-1 text-sm text-primary" aria-live="polite"></p>
            </div>
            <form data-action="submit->portal--events#reviewSelection">
              <%= button "Review seats", type: "submit", variant: :primary, size: :sm, disabled: true, data: { selection_review: true } %>
            </form>
          <% end %>
        </section>
      <% end %>
    </div>
    <%= render "footer" %>
  </main>
<template id="event-error-template"><%= status_alert title: "Event could not load", description: "Check your connection and try again.", variant: :error, icon: "triangle-alert", action: button("Retry", variant: :error, size: :sm, data: { action: "click->portal--events#retry" }) %></template>
<template id="event-not-found-template">
  <%= card card_class: "border border-base-300 bg-base-100", body_class: "items-center py-14 text-center" do %>
    <%= lucide "calendar-x", class: "size-9 text-base-content/35" %><%= card_title "Event not found" %>
    <p class="text-sm text-base-content/60">This event may have been removed or the link may be incorrect.</p>
    <%= button "Browse events", variant: :primary, size: :sm, href: root_path %>
  <% end %>
</template>
</div>
