<% content_for :title, "Discover events · Seatwise" %>
<div class="min-h-screen bg-base-200/60" data-controller="portal--events" data-events-index>
  <%= render "header" %>
  <main class="mx-auto max-w-7xl space-y-9 px-4 py-5 sm:px-8 sm:py-8">
    <section class="relative isolate overflow-hidden rounded-box bg-neutral text-neutral-content shadow-xl">
      <div class="absolute -right-16 -top-24 -z-10 size-96 rounded-full bg-primary/25 blur-3xl" aria-hidden="true"></div>
      <div class="grid gap-5 px-6 py-7 sm:px-10 sm:py-9 lg:grid-cols-[1fr_auto] lg:items-center lg:px-14">
        <div class="max-w-3xl">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">Live experiences, thoughtfully seated</p>
          <h1 class="text-3xl font-black tracking-tight sm:text-5xl">A good night starts with a seat.</h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-neutral-content/70 sm:text-base">Find a performance worth leaving home for. Then find a seat that feels like yours.</p>
        </div>
        <div class="flex flex-wrap gap-2 lg:justify-end">
          <%= badge "Thoughtful seat selection", style: :outline, extra_class: "border-neutral-content/25 text-neutral-content" %>
          <span id="event-count" class="badge badge-outline border-neutral-content/25 text-neutral-content" hidden></span>
        </div>
      </div>
    </section>

    <section id="about" class="grid gap-5 lg:grid-cols-3" aria-label="How it works">
      <%= card card_class: "border border-base-300 bg-base-100", body_class: "gap-2" do %>
        <%= lucide "sparkles", class: "mb-2 size-5 text-primary" %><%= card_title "A night worth finding" %>
        <p class="text-sm leading-6 text-base-content/60">Explore a growing calendar of live performances and find something new to look forward to.</p>
      <% end %>
      <%= card card_class: "border border-base-300 bg-base-100", body_class: "gap-2" do %>
        <%= lucide "armchair", class: "mb-2 size-5 text-primary" %><%= card_title "Know the room" %>
        <p class="text-sm leading-6 text-base-content/60">Get a simple view of venue layouts and current seat availability before you choose.</p>
      <% end %>
      <%= card card_class: "border border-base-300 bg-base-100", body_class: "gap-2" do %>
        <%= lucide "ticket", class: "mb-2 size-5 text-primary" %><%= card_title "Reservations, next" %>
        <p class="text-sm leading-6 text-base-content/60">We’re getting the experience ready. Reservation and checkout flows will follow.</p>
      <% end %>
    </section>

    <section class="scroll-mt-24 space-y-6" aria-labelledby="events-heading">
      <%= section_heading kicker: "The calendar", title: "Find your event", description: "Explore performances and see what’s still open in the room.", heading_id: "events-heading" %>
      <%= form_with url: root_path, method: :get, id: "event-filters", class: "flex flex-col gap-3 rounded-box border border-base-300 bg-base-100 p-3 sm:flex-row sm:items-center" do |form| %>
        <label class="input input-bordered flex w-full items-center gap-2 sm:max-w-md">
          <%= lucide "search", class: "size-4 text-base-content/45" %>
          <%= form.search_field :q, value: params[:q], class: "grow", placeholder: "Search events or venues", aria: { label: "Search events or venues" } %>
        </label>
        <%= form.label :when, "Event dates", class: "sr-only" %>
        <%= form.select :when, [["All events", "all"], ["Upcoming", "upcoming"], ["Past events", "past"]], { selected: params[:when].presence || "upcoming" }, class: "select select-bordered w-full sm:w-44", data: { action: "change->portal--events#filtersChanged" } %>
        <%= form.select :sort, [["Oldest first", "soonest"], ["Newest first", "latest"], ["Name", "name"]], { selected: params[:sort].presence || "soonest" }, class: "select select-bordered w-full sm:w-44", aria: { label: "Sort events" }, data: { action: "change->portal--events#filtersChanged" } %>
        <%= button "Search", type: "submit", variant: :neutral, class: "sm:ml-auto" %>
      <% end %>

      <div id="events-loading" class="hidden grid gap-5 md:grid-cols-2 xl:grid-cols-3" aria-live="polite" hidden>
        <% 3.times do %>
          <%= card card_class: "border border-base-300 bg-base-100", body_class: "gap-4 p-0" do %>
            <div class="skeleton h-44 rounded-b-none"></div>
            <div class="space-y-3 p-5"><div class="skeleton h-4 w-1/3"></div><div class="skeleton h-6 w-2/3"></div><div class="skeleton h-10 w-full"></div></div>
          <% end %>
        <% end %>
      </div>
      <div id="events-error" hidden></div>
      <div id="events-empty" hidden></div>
      <div id="events-list" class="grid gap-5 md:grid-cols-2 xl:grid-cols-3" aria-live="polite" hidden></div>
      <nav id="events-pagination" class="flex items-center justify-center gap-4" aria-label="Event pages" hidden>
        <div class="join">
          <%= button "Previous", size: :sm, class: "join-item", data: { action: "click->portal--events#previousPage", page_previous: true } %>
          <%= button "Next", size: :sm, class: "join-item", data: { action: "click->portal--events#nextPage", page_next: true } %>
        </div>
      </nav>
    </section>

    <%= render "footer" %>
  </main>
<template id="event-card-template">
  <%= card element: :article, body: false, card_class: "overflow-hidden border border-base-300 bg-base-100 transition-shadow hover:shadow-xl" do %>
    <a class="group block text-base-content no-underline" data-event-link href="#">
      <div class="relative grid h-44 place-items-center overflow-hidden bg-gradient-to-br from-primary/30 via-secondary/20 to-accent/30">
        <span class="grid size-14 place-items-center rounded-full bg-base-100/75 text-primary shadow-sm" aria-hidden="true"><%= lucide "music-2", class: "size-6" %></span>
        <span data-event-date class="badge absolute left-4 top-4 border-base-100/70 bg-base-100/90"></span>
        <span data-event-past class="badge badge-outline absolute right-4 top-4 border-base-100/70 bg-base-100/90" hidden>Past event</span>
        <span data-event-availability class="badge badge-neutral absolute bottom-4 left-4"></span>
      </div>
      <%= card_body body_class: "gap-3" do %>
        <div class="flex items-center gap-2 text-sm font-medium text-base-content/55"><span data-event-time></span><span aria-hidden="true">·</span><span data-event-venue></span></div>
        <h3 data-event-name class="card-title text-xl"></h3>
        <div class="mt-2 flex items-center justify-between border-t border-base-200 pt-4"><span data-event-capacity class="text-sm text-base-content/60"></span><span class="btn btn-sm btn-primary">Explore <%= lucide "arrow-up-right", class: "size-4" %></span></div>
      <% end %>
    </a>
  <% end %>
</template>
<template id="event-empty-template">
  <%= card card_class: "border border-base-300 bg-base-100", body_class: "items-center py-14 text-center" do %>
    <%= lucide "calendar-search", class: "size-9 text-base-content/35" %><%= card_title "No events found" %>
    <p class="text-sm text-base-content/60">Try another search or switch the date filter.</p>
  <% end %>
</template>
<template id="event-error-template"><%= status_alert title: "Events could not load", description: "Check your connection and try again.", variant: :error, icon: "triangle-alert", action: button("Retry", variant: :error, size: :sm, data: { action: "click->portal--events#retry" }) %></template>
</div>
