.mt-6.scroll-mt-20.hidden#checkout-panel{
  hidden: "",
  role: "region",
  "aria-label": "Reservation",
  data: {
    controller: "portal--checkout",
    action: "portal--reservation:checkout-setup->portal--checkout#setup portal--reservation:checkout-stage->portal--checkout#stageChanged portal--reservation:checkout-reset->portal--checkout#reset portal--reservation:checkout-return->portal--checkout#restore portal--reservation:checkout-poll->portal--checkout#poll"
  }
}
  = card card_class: "border border-base-300 bg-base-100", body_class: "gap-6" do
    %ul.steps.steps-horizontal.w-full.text-xs.sm:text-sm{"aria-label": "Reservation progress"}
      %li.step.step-primary{"data-booking-step": "1", "data-content": "1"}
        %button.cursor-pointer.border-0.bg-transparent.px-1.py-0.font-sans.text-xs.text-inherit.hover:underline.focus-visible:outline-2.focus-visible:outline-offset-2.focus-visible:outline-primary.sm:text-sm.disabled:cursor-not-allowed.disabled:opacity-60{
          type: "button",
          data: { action: "click->portal--reservation#navigateToStep", flow_step: "seats" }
        }
          Choose seats
      %li.step{"data-booking-step": "2", "data-content": "2"}
        %button.cursor-pointer.border-0.bg-transparent.px-1.py-0.font-sans.text-xs.text-inherit.hover:underline.focus-visible:outline-2.focus-visible:outline-offset-2.focus-visible:outline-primary.sm:text-sm.disabled:cursor-not-allowed.disabled:opacity-60{
          type: "button",
          data: { action: "click->portal--reservation#navigateToStep", flow_step: "payment" }
        }
          Payment
      %li.step{"data-booking-step": "3", "data-content": "3"} Confirmation
    .rounded-box.border.border-base-300.bg-base-100.p-4{hidden: "", "data-reservation-request": ""}
      .flex.flex-wrap.items-center.justify-between.gap-3
        %div
          %p.text-sm.font-semibold Your reservation
          %p.mt-1.text-xs{class: "text-base-content/65", data: { reservation_request_attempt: true }
          }
            Your seats are held while you complete checkout.
        %span.badge.badge-success.badge-soft{data: { reservation_request_status: true }} Hold active
    %section{class: "space-y-2.5", "data-flow-stage": "seats", "aria-labelledby": "email-title"}
      .mx-auto.w-full.max-w-xl.space-y-5
        %div
          %h2.reservation-stage-heading.mt-1.w-fit.max-w-full.text-2xl.font-bold#email-title{
            tabindex: "-1",
            "data-stage-heading": ""
          }
            Where should we send your tickets?
          %p.mt-2.text-sm{class: "text-base-content/65"}
            We’ll hold your seats for five minutes when you continue to payment.
        %form.space-y-4{
          "data-action": "submit->portal--reservation#placeHold",
          "data-checkout-form": ""
        }
          %div
            %input.input.w-full#reservation-email{
              type: "email",
              name: "email",
              autocomplete: "email",
              "aria-label": "Email",
              placeholder: "name@domain.com",
              required: true,
              "data-action": "input->portal--reservation#saveEmail"
            }/

            %p.mt-1.5.text-sm{class: "text-base-content/65", data: { email_help: true }}
              We’ll send your tickets and booking details here.
          %p.text-sm.text-info{"aria-live": "polite", "data-request-status": ""}
            Your seats are ready to reserve. Continue to place your five-minute hold.
          %p.text-sm.text-error{"aria-live": "polite", data: { hold_error: true }, hidden: ""}
          .flex.flex-wrap.items-center.gap-2
            = button "Continue to payment", type: "submit", variant: :primary, data: { hold_submit: true }
    %section.space-y-6{hidden: "", "data-flow-stage": "payment", "aria-labelledby": "checkout-title"
    }
      %div
        .flex.flex-wrap.items-baseline.gap-3
          %h2.reservation-stage-heading.w-fit.max-w-full.text-2xl.font-bold#checkout-title{
            tabindex: "-1",
            "data-stage-heading": ""
          }
            Payment
          = badge safe_join([lucide("circle-check", class: "size-3.5"), "Hold created"]), variant: :success, style: :soft, size: :sm, extra_class: "gap-1.5 text-green-800"
        %p.mt-2.text-sm{class: "text-base-content/65"}
          Your seats are held while you finish checkout.
      .mx-auto.w-full.space-y-5{class: "max-w-6xl"}
        .grid.items-start.gap-5{class: "lg:grid-cols-2"}
          = card card_class: "order-1 border border-base-300 bg-base-200/70 shadow-sm lg:sticky lg:top-6 lg:order-2", body_class: "gap-4 p-4 sm:p-5" do
            .alert.alert-warning.alert-soft.flex.flex-wrap.items-center.justify-between.gap-3{
              role: "status"
            }
              .flex.items-center.gap-3
                = lucide "clock-3", class: "size-5 shrink-0"
                %div
                  %p.font-semibold Seats held
                  = button "Cancel hold", variant: :ghost, class: "mt-1 h-auto min-h-0 justify-start px-0 py-0 text-sm font-medium text-base-content/80 hover:bg-transparent hover:border-transparent hover:shadow-none hover:text-error", data: { action: "click->portal--reservation#cancelHold" }
              .text-right
                %p.text-2xl.font-black.tabular-nums{"aria-live": "off", "data-hold-countdown": ""}
                  5:00
                %p.text-xs{data: { hold_deadline: true }} Pending
            %p.text-sm.text-error{"aria-live": "polite", data: { cancel_error: true }, hidden: ""}
            %div
              %p.text-sm.font-semibold Order summary
              %p.mt-1.text-lg.font-bold{data: { reservation_event: true }} Event name
            %dl.space-y-3.text-sm
              %div
                %dt.text-xs{class: "text-base-content/55"} Date &amp; time
                %dd.mt-1.font-medium{data: { reservation_date: true }} Event date
              %div
                %dt.text-xs{class: "text-base-content/55"} Venue
                %dd.mt-1.font-medium{data: { reservation_venue: true }} Venue name
              %div
                %dt.text-xs{class: "text-base-content/55"} Seats
                %dd.mt-1.font-medium{"data-seat-summary": ""} No seats selected
              %div
                %dt.text-xs{class: "text-base-content/55"} Booking email
                %dd.mt-1.font-medium{data: { reservation_email: true }} Email pending
              .border-t.border-base-300.pt-3
                %dt.text-xs{class: "text-base-content/55"} Total
                %dd.mt-1.text-lg.font-bold{data: { reservation_total: true }} —
          .order-2.mx-auto.w-full{class: "lg:order-1"}
            = card card_class: "border border-primary/15 bg-primary/5 shadow-sm", body_class: "gap-4 p-4 sm:p-6" do
              %div
                %p.text-base.font-semibold Pay securely
                %p.mt-1.text-sm{class: "text-base-content/65"}
                  Your payment details are handled securely by Stripe.
              .space-y-2{data: { express_checkout_region: true }, hidden: ""}
                %p.text-sm.font-semibold Express checkout
                %div{data: { express_checkout_element: true }}
              %p.text-sm{
                class: "text-base-content/60",
                data: { wallet_availability: true },
                hidden: ""
              }
                No accelerated payment methods are available in this browser. You can still pay by card below.
              %p.text-sm{class: "text-base-content/60", data: { payment_loading: true }}
                Loading payment options…
              %div{data: { payment_element: true }, aria: { label: "Payment details" }}
              %p.alert.alert-error.alert-soft.py-3.text-sm{
                role: "alert",
                data: { payment_error: true },
                hidden: ""
              }

              = button "Retry payment setup", type: "button", variant: :outline, data: { action: "click->portal--checkout#retrySetup", payment_retry: true }, hidden: true
              %p.text-sm.text-info{"aria-live": "polite", data: { payment_status: true }}
                Loading payment options…
              = button "Pay securely", type: "button", variant: :primary, size: :lg, class: "w-full", data: { action: "click->portal--checkout#confirmPayment", payment_submit: true }, disabled: true
    %section.space-y-5{
      hidden: "",
      "data-flow-stage": "redirecting",
      "aria-labelledby": "redirecting-title"
    }
      .mx-auto.w-full.max-w-xl.space-y-5
        .alert.flex.items-start.gap-3.bg-base-200{role: "status"}
          %span.loading.loading-spinner.loading-sm.mt-0.5.shrink-0.text-info{"aria-hidden": "true"}
          %div
            %p.font-semibold Payment submitted
            %p.mt-1.text-sm{class: "text-base-content/65", data: { checkout_return_status: true }}
              We’re checking your payment with Stripe.
        %div
          %h2.reservation-stage-heading.w-fit.max-w-full.text-2xl.font-bold#redirecting-title{
            tabindex: "-1",
            "data-stage-heading": "",
            data: { payment_title: true }
          }
            Opening secure checkout…
          %p.mt-2.text-sm{class: "text-base-content/65", data: { payment_copy: true }}
            Your seats remain held until your payment is confirmed.
        = card card_class: "border border-base-300 bg-base-100 shadow-sm", body_class: "gap-4 p-4 sm:p-6" do
          .flex.items-center.justify-between.gap-3.border-b.border-base-300.pb-4
            = image_tag "/stripe.png", alt: "Stripe", class: "inline-block h-[18px] w-auto align-middle", data: { payment_brand: true }
            %span{data: { payment_badge: true }}
              = badge safe_join([lucide("lock-keyhole", class: "size-3.5"), "Secure payment"]), variant: :success, style: :soft, size: :sm, extra_class: "gap-1.5"
          = button "Check payment status", variant: :outline, class: "self-start", data: { action: "click->portal--checkout#checkStatus", check_payment_status: true }, hidden: true
          %div
            %p.text-sm.font-semibold{"data-seat-summary": ""} No seats selected
            .mt-3.flex.flex-wrap.items-center.justify-between.gap-2
              %p.text-sm{class: "text-base-content/65"} Hold time remaining
              %p.text-lg.font-bold.tabular-nums{"data-hold-countdown": ""} 5:00
    %section.space-y-5{
      hidden: "",
      "data-flow-stage": "confirmed",
      "aria-labelledby": "confirmed-title"
    }
      .mx-auto.w-full.space-y-5{class: "max-w-xl"}
        .flex.items-start.gap-3.border-l-4.border-success.pl-4{role: "status"}
          = lucide "circle-check", class: "mt-0.5 size-5 shrink-0 text-success"
          %div
            %p.font-semibold Reservation confirmed
            %p.mt-1.text-sm{class: "text-base-content/65"}
              Your payment is complete and your seats are booked.
        %div
          %h2.reservation-stage-heading.mt-1.w-fit.max-w-full.text-2xl.font-bold#confirmed-title{
            tabindex: "-1",
            "data-stage-heading": ""
          }
            You’re going to the show
          %p.mt-2.text-sm{class: "text-base-content/65"}
            = "We’ve sent your confirmation to "
            %span.font-semibold.text-base-content{data: { reservation_email: true }} Email pending
        .w-full.rounded-box.border.border-base-300.bg-base-100.p-4.shadow-sm
          %dl.grid.gap-3.text-sm{class: "sm:grid-cols-2"}
            %div
              %dt.text-xs{class: "text-base-content/55"} Event
              %dd.mt-1.font-medium{data: { reservation_event: true }} Event name
            %div
              %dt.text-xs{class: "text-base-content/55"} Date &amp; time
              %dd.mt-1.font-medium{data: { reservation_date: true }} Event date
            %div
              %dt.text-xs{class: "text-base-content/55"} Venue
              %dd.mt-1.font-medium{data: { reservation_venue: true }} Venue name
            %div
              %dt.text-xs{class: "text-base-content/55"} Booking reference
              %dd.mt-1.font-mono.font-semibold{data: { reservation_reference: true }} Pending
          .mt-5.border-t.border-base-300.pt-4{hidden: "", data: { confirmed_invoice: true }}
            .grid.grid-cols-2.items-start.gap-4
              %div
                %p.text-xs{class: "text-base-content/55"} Event tickets
                %p.mt-1.font-semibold{data: { invoice_seat_summary: true }} Seats pending
                %p.mt-0.5.whitespace-nowrap.text-xs{
                  class: "text-base-content/60",
                  data: { invoice_ticket_summary: true }
                }
                  Ticket price pending
              %p.self-center.text-left.text-lg.font-bold.tabular-nums{
                data: { invoice_line_total: true }
              }
                —
            .mt-4.grid.grid-cols-2.items-center.gap-4.border-t.border-base-300.pt-4{role: "status"}
              %p.text-sm{class: "text-base-content/65"}
                Payment processed by
                = image_tag "/stripe.png", alt: "Stripe", class: "ml-1 inline-block h-[18px] w-auto align-middle"
              %span.badge.badge-success.badge-soft Payment complete
        = button "Start another reservation", variant: :primary, data: { action: "click->portal--reservation#startAgain" }
    %section.space-y-5{hidden: "", "data-flow-stage": "expired", "aria-labelledby": "expired-title"}
      = status_alert title: "Hold expired", description: "These seats are no longer reserved. Choose seats to begin again.", variant: :warning, icon: "clock-3", soft: true
      %h2.reservation-stage-heading.w-fit.max-w-full.text-2xl.font-bold#expired-title{
        tabindex: "-1",
        "data-stage-heading": ""
      }
        Your hold timed out
      = button "Choose seats again", variant: :primary, data: { action: "click->portal--reservation#startAgain" }
