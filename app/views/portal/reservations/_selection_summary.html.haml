= card card_class: "mt-6 border border-base-300 bg-base-100", body_class: "gap-4 sm:flex-row sm:items-center sm:justify-between" do
  .flex.min-w-0.flex-1.items-center.gap-3
    .flex.size-10.shrink-0.items-center.justify-center.rounded-box{
      class: "bg-primary/10 text-primary"
    }
      = lucide "armchair", class: "size-5"
    .min-w-0.flex-1
      %p.whitespace-nowrap.text-sm{class: "text-base-content/60", data: { selection_count: true }}
        Click or drag across up to 6 open seats in one row.
      %p.mt-1.text-sm.text-primary{"aria-live": "polite", "data-selection-message": ""}
      %span.sr-only{aria: { atomic: true, live: "polite" }, data: { selection_accessible_summary: true }}
  .flex.min-w-0.flex-wrap.items-center.gap-4.sm:flex-1.sm:justify-end
    .flex.flex-wrap.items-center.gap-3{
      hidden: "",
      "aria-hidden": "true",
      data: { selection_visual: true }
    }

    %span.badge.badge-success.badge-soft{hidden: "", data: { selection_reservation_status: true }}
