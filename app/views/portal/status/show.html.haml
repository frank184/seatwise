- content_for :title, "System status · Seatwise"
.min-h-full{class: "bg-base-200/60", "data-controller": "portal--status"}
  %main.mx-auto.max-w-6xl.space-y-8.px-4.py-6.sm:px-8.sm:py-10
    %section.relative.isolate.overflow-hidden.rounded-box.bg-neutral.text-neutral-content.shadow-xl
      .absolute.-right-20.-top-28.-z-10.size-96.rounded-full.blur-3xl{
        "aria-hidden": "true",
        class: "bg-success/20"
      }

      .absolute.-bottom-36.-z-10.size-80.rounded-full.blur-3xl{
        "aria-hidden": "true",
        class: "left-1/3 bg-primary/20"
      }

      .grid.gap-8.px-6.py-8.sm:px-10.sm:py-10.lg:items-end.lg:px-14{class: "lg:grid-cols-[1fr_auto]"
      }
        .max-w-2xl
          .mb-5.flex.items-center.gap-2.text-xs.font-bold.uppercase{
            class: "tracking-[0.22em] text-neutral-content/65"
          }
            = lucide "activity", class: "size-4 text-success"
            Seatwise system status
          .flex.items-center.gap-3
            %span.status.status-lg.status-neutral{
              "aria-label": "Status is being checked",
              "data-portal--status-target": "summaryState",
              role: "img"
            }

            %h1.text-3xl.font-black.tracking-tight.sm:text-5xl{
              "data-portal--status-target": "summaryTitle"
            }
              Checking systems…
          %p.mt-4.max-w-xl.text-sm.leading-6.sm:text-base{
            class: "text-neutral-content/70",
            "data-portal--status-target": "summaryDescription"
          }
            We’re checking the live health endpoints now.
        = button "Refresh checks", variant: :primary, data: { action: "click->portal--status#refresh", portal__status_target: "refreshButton" } do
          = lucide "refresh-cw", class: "size-4"
    %section.space-y-5{"aria-labelledby": "services-heading"}
      .flex.flex-col.gap-2.sm:flex-row.sm:items-end.sm:justify-between
        %div
          %p.text-sm.font-semibold.text-primary Live checks
          %h2.mt-1.text-2xl.font-bold.tracking-tight.sm:text-3xl#services-heading Core services
        %p.text-sm{class: "text-base-content/60"}
          Last checked
          %time{"data-portal--status-target": "checkedAt"} during initial check
      .grid.gap-4.md:grid-cols-2
        = card element: :article, card_class: "border border-base-300 bg-base-100 shadow-sm", body_class: "gap-5 p-5 sm:p-6" do
          .flex.items-start.justify-between.gap-4
            .flex.items-start.gap-4
              %span.grid.size-12.shrink-0.place-items-center.rounded-box.text-primary{
                class: "bg-primary/10"
              }
                = lucide "boxes", class: "size-6"
              %div
                %p.text-xs.font-bold.uppercase{class: "tracking-[0.18em] text-base-content/45"}
                  API · v1
                %h3.mt-1.text-lg.font-bold Public API
            %span.status.status-md.status-neutral{
              "aria-label": "Checking API",
              "data-endpoint": "/api/v1/up",
              "data-portal--status-target": "status",
              role: "img"
            }

          .flex.items-end.justify-between.gap-4.border-t.border-base-200.pt-4
            %p.text-sm{class: "text-base-content/60", "data-portal--status-target": "message"}
              Waiting for the health check…
            %span.shrink-0.font-mono.text-xs{
              class: "text-base-content/45",
              "data-portal--status-target": "latency"
            }
              —
        = card element: :article, card_class: "border border-base-300 bg-base-100 shadow-sm", body_class: "gap-5 p-5 sm:p-6" do
          .flex.items-start.justify-between.gap-4
            .flex.items-start.gap-4
              %span.grid.size-12.shrink-0.place-items-center.rounded-box.text-secondary{
                class: "bg-secondary/15"
              }
                = lucide "server", class: "size-6"
              %div
                %p.text-xs.font-bold.uppercase{class: "tracking-[0.18em] text-base-content/45"}
                  Application
                %h3.mt-1.text-lg.font-bold Rails process
            %span.status.status-md.status-neutral{
              "aria-label": "Checking Rails process",
              "data-endpoint": "/up",
              "data-portal--status-target": "status",
              role: "img"
            }

          .flex.items-end.justify-between.gap-4.border-t.border-base-200.pt-4
            %p.text-sm{class: "text-base-content/60", "data-portal--status-target": "message"}
              Waiting for the health check…
            %span.shrink-0.font-mono.text-xs{
              class: "text-base-content/45",
              "data-portal--status-target": "latency"
            }
              —
    .flex.flex-col.gap-3.rounded-box.border.border-base-300.px-5.py-4.text-sm.sm:flex-row.sm:items-center.sm:justify-between{
      class: "bg-base-100/70 text-base-content/60"
    }
      %p.flex.items-center.gap-2
        = lucide "info", class: "size-4 shrink-0"
        Checks run live in your browser. This page does not store check history.
      .flex.gap-4.pl-6.sm:pl-0
        %a.link.link-hover{href: "/api/v1/up"} API endpoint
        %a.link.link-hover{href: "/up"} Rails endpoint
