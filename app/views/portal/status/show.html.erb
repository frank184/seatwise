<% content_for :title, "System status · Seatwise" %>
<div class="min-h-screen bg-base-200/60" data-controller="portal--status">
  <%= render "portal/events/header" %>

  <main class="mx-auto max-w-6xl space-y-8 px-4 py-6 sm:px-8 sm:py-10">
    <section class="relative isolate overflow-hidden rounded-box bg-neutral text-neutral-content shadow-xl">
      <div class="absolute -right-20 -top-28 -z-10 size-96 rounded-full bg-success/20 blur-3xl" aria-hidden="true"></div>
      <div class="absolute -bottom-36 left-1/3 -z-10 size-80 rounded-full bg-primary/20 blur-3xl" aria-hidden="true"></div>
      <div class="grid gap-8 px-6 py-8 sm:px-10 sm:py-10 lg:grid-cols-[1fr_auto] lg:items-end lg:px-14">
        <div class="max-w-2xl">
          <div class="mb-5 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.22em] text-neutral-content/65">
            <%= lucide "activity", class: "size-4 text-success" %>
            Seatwise system status
          </div>
          <div class="flex items-center gap-3">
            <span data-portal--status-target="summaryState" class="status status-lg status-neutral" role="img" aria-label="Status is being checked"></span>
            <h1 data-portal--status-target="summaryTitle" class="text-3xl font-black tracking-tight sm:text-5xl">Checking systems…</h1>
          </div>
          <p data-portal--status-target="summaryDescription" class="mt-4 max-w-xl text-sm leading-6 text-neutral-content/70 sm:text-base">We’re checking the live health endpoints now.</p>
        </div>
        <%= button "Refresh checks", variant: :primary, data: { action: "click->portal--status#refresh", portal__status_target: "refreshButton" } do %>
          <%= lucide "refresh-cw", class: "size-4" %>
        <% end %>
      </div>
    </section>

    <section class="space-y-5" aria-labelledby="services-heading">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold text-primary">Live checks</p>
          <h2 id="services-heading" class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">Core services</h2>
        </div>
        <p class="text-sm text-base-content/60">Last checked <time data-portal--status-target="checkedAt">during initial check</time></p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <%= card element: :article, card_class: "border border-base-300 bg-base-100 shadow-sm", body_class: "gap-5 p-5 sm:p-6" do %>
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-start gap-4">
              <span class="grid size-12 shrink-0 place-items-center rounded-box bg-primary/10 text-primary"><%= lucide "boxes", class: "size-6" %></span>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-base-content/45">API · v1</p>
                <h3 class="mt-1 text-lg font-bold">Public API</h3>
              </div>
            </div>
            <span data-portal--status-target="status" data-endpoint="/api/v1/up" class="status status-md status-neutral" role="img" aria-label="Checking API"></span>
          </div>
          <div class="flex items-end justify-between gap-4 border-t border-base-200 pt-4">
            <p data-portal--status-target="message" class="text-sm text-base-content/60">Waiting for the health check…</p>
            <span data-portal--status-target="latency" class="shrink-0 font-mono text-xs text-base-content/45">—</span>
          </div>
        <% end %>

        <%= card element: :article, card_class: "border border-base-300 bg-base-100 shadow-sm", body_class: "gap-5 p-5 sm:p-6" do %>
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-start gap-4">
              <span class="grid size-12 shrink-0 place-items-center rounded-box bg-secondary/15 text-secondary"><%= lucide "server", class: "size-6" %></span>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-base-content/45">Application</p>
                <h3 class="mt-1 text-lg font-bold">Rails process</h3>
              </div>
            </div>
            <span data-portal--status-target="status" data-endpoint="/up" class="status status-md status-neutral" role="img" aria-label="Checking Rails process"></span>
          </div>
          <div class="flex items-end justify-between gap-4 border-t border-base-200 pt-4">
            <p data-portal--status-target="message" class="text-sm text-base-content/60">Waiting for the health check…</p>
            <span data-portal--status-target="latency" class="shrink-0 font-mono text-xs text-base-content/45">—</span>
          </div>
        <% end %>
      </div>
    </section>

    <div class="flex flex-col gap-3 rounded-box border border-base-300 bg-base-100/70 px-5 py-4 text-sm text-base-content/60 sm:flex-row sm:items-center sm:justify-between">
      <p class="flex items-center gap-2"><%= lucide "info", class: "size-4 shrink-0" %>Checks run live in your browser. This page does not store check history.</p>
      <div class="flex gap-4 pl-6 sm:pl-0">
        <a class="link link-hover" href="/api/v1/up">API endpoint</a>
        <a class="link link-hover" href="/up">Rails endpoint</a>
      </div>
    </div>
  </main>
</div>
