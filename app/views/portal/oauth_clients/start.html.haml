- content_for :title, "Connect to Seatwise · Seatwise"
%main.mx-auto.w-full.max-w-xl.px-4.py-10.sm:px-6.sm:py-16
  = card title: "Connect to Seatwise", description: "Authorize this browser to manage your reservations.", body_class: "gap-6 p-6 sm:p-8" do
    #oauth-client-status
      = status_alert title: "Secure sign-in", description: "We’ll send you to Seatwise sign-in if needed, then return here to finish connecting.", variant: :info, soft: true, role: "status"
    %button.btn.btn-primary.btn-lg.w-full{
      type: "button",
      data: {
        controller: "portal--oauth",
        action: "click->portal--oauth#start",
        client_id: @client_id,
        redirect_uri: @redirect_uri,
        return_to: @return_to
      }
    }
      Continue with Seatwise
